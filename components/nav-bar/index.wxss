/* nav-bar · v3：大标题 + 灰色副标题，无分隔线 */
.nav {
  display: flex;
  flex-direction: column;
  background-color: #F4F4F4;
  padding-left: 16px;
  padding-right: 16px;
}

.status-pad {
  width: 100%;
}

.nav-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 8px;
}

.nav-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nav-title {
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
  font-size: 27px;
  line-height: 1.2;
  letter-spacing: -0.4px;
  color: #2A3A32;
}

.nav-sub {
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 11px;
  letter-spacing: 0.2px;
  color: #8B908A;
  margin-top: 4px;
  line-height: 1.4;
}

.nav-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-top: 6px;
}