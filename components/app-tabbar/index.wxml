<view class="tabbar-wrap">
	<view class="tabbar">
		<view
			class="tb-cell"
			wx:for="{{tabs}}"
			wx:key="key"
			data-key="{{item.key}}"
			data-path="{{item.path}}"
			bindtap="go"
		>
			<view class="{{active == item.key ? 'tb-pill tb-pill-on' : 'tb-pill'}}">
				<image class="tb-ico" src="{{active == item.key ? item.iconOn : item.icon}}"></image>
				<text class="{{active == item.key ? 'tb-t tb-t-on' : 'tb-t'}}">{{item.label}}</text>
			</view>
		</view>
	</view>
</view>
