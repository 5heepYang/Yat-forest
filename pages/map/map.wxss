.page {
	display: flex;
	flex-direction: column;
	height: 100vh;
	position: relative;
	background-color: #FFFCF6;
	font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "PingFang SC", "MiSans", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
}

.icon-btn {
	display: flex;
	flex-direction: column;
	width: 36px;
	height: 36px;
	border-radius: 18px;
	background-color: #FFFFFF;
	align-items: center;
	justify-content: center;
	box-shadow: 0px 2px 6px rgba(46, 107, 79, 0.08);
}

.icon-18 {
	width: 17px;
	height: 17px;
}

.map-wrap {
	display: flex;
	flex-direction: column;
	flex: 1;
	position: relative;
	overflow: hidden;
}

.map-bg {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: #E7F0D8;
}

.blob {
	position: absolute;
	background-color: #E2EED5;
	border-radius: 60px;
}

.blob-1 {
	left: 8%;
	top: 26%;
	width: 54%;
	height: 15%;
}

.blob-2 {
	right: -8%;
	top: 44%;
	width: 46%;
	height: 13%;
	background-color: #DEEBD2;
}

.blob-3 {
	left: 4%;
	top: 64%;
	width: 62%;
	height: 16%;
	background-color: #E4F0D9;
}

.road {
	position: absolute;
	background-color: #FFFFFF;
	border-radius: 9px;
}

.road-1 {
	left: -6%;
	top: 40%;
	width: 112%;
	height: 16px;
	transform: rotate(-3deg);
}

.road-2 {
	left: 46%;
	top: 52%;
	width: 60%;
	height: 14px;
	transform: rotate(-42deg);
}

.lake {
	position: absolute;
	right: 6%;
	bottom: 14%;
	width: 96px;
	height: 88px;
	border-radius: 48px;
	background-color: #CBE3DE;
}

.bld {
	position: absolute;
	background-color: #F1EBDC;
	border-radius: 6px;
}

.bld-1 {
	left: 12%;
	top: 12%;
	width: 52px;
	height: 34px;
}

.bld-2 {
	left: 58%;
	top: 10%;
	width: 46px;
	height: 30px;
}

.bld-3 {
	left: 30%;
	top: 70%;
	width: 44px;
	height: 26px;
}

.dot {
	position: absolute;
	width: 10px;
	height: 10px;
	border-radius: 5px;
	background-color: #CFE3BC;
}

.dot-1 {
	left: 24%;
	top: 34%;
}

.dot-2 {
	left: 72%;
	top: 30%;
}

.dot-3 {
	left: 18%;
	top: 56%;
}

.float-top {
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 16px;
	right: 16px;
	top: 8px;
	z-index: 10;
}

.search-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.search-pill {
	display: flex;
	flex-direction: row;
	flex: 1;
	height: 44px;
	background-color: #FFFFFF;
	border-radius: 22px;
	align-items: center;
	padding-left: 16px;
	box-shadow: 0px 2px 8px rgba(46, 107, 79, 0.06);
}

.ic-search {
	width: 15px;
	height: 15px;
	margin-right: 9px;
}

.search-ph {
	font-size: 12px;
	color: #B4BCAF;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.filter-btn {
	display: flex;
	flex-direction: column;
	width: 44px;
	height: 44px;
	border-radius: 22px;
	background-color: #FFFFFF;
	align-items: center;
	justify-content: center;
	margin-left: 10px;
	box-shadow: 0px 2px 8px rgba(46, 107, 79, 0.06);
}

.ic-sliders {
	width: 16px;
	height: 16px;
}

.chip-row {
	display: flex;
	flex-direction: row;
	margin-top: 14px;
}

.chip {
	display: flex;
	flex-direction: row;
	height: 28px;
	border-radius: 14px;
	background-color: #FFFFFF;
	align-items: center;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 8px;
}

.chip-on {
	background-color: #4E8A6B;
}

.chip-dot {
	width: 6px;
	height: 6px;
	border-radius: 3px;
	background-color: #6BB98A;
	margin-right: 6px;
}

.chip-ring {
	width: 8px;
	height: 8px;
	border-radius: 4px;
	border-width: 1.5px;
	border-style: solid;
	border-color: #A9C7B1;
	margin-right: 6px;
}

.chip-t {
	font-size: 11px;
	color: #5C6B60;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.chip-t-on {
	color: #FFFFFF;
	font-weight: bold;
}

.hint-pill {
	display: flex;
	flex-direction: column;
	position: absolute;
	right: 22px;
	top: 192px;
	height: 28px;
	border-radius: 14px;
	background-color: #FFFFFF;
	padding-left: 12px;
	padding-right: 12px;
	align-items: center;
	justify-content: center;
	box-shadow: 0px 2px 8px rgba(46, 107, 79, 0.08);
}

.hint-t {
	font-size: 10px;
	color: #5C6B60;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.pin {
	display: flex;
	flex-direction: column;
	position: absolute;
	width: 30px;
	height: 38px;
	margin-left: -15px;
	margin-top: -34px;
	align-items: center;
}

.pin-head {
	display: flex;
	flex-direction: column;
	width: 30px;
	height: 30px;
	border-radius: 15px;
	align-items: center;
	justify-content: center;
	border-width: 2px;
	border-style: solid;
	border-color: #FFFFFF;
}

.pin-head-mine {
	background-color: #4E8A6B;
}

.pin-head-plain {
	background-color: #FFFFFF;
	border-color: #C6D9C8;
}

.pin-head-warn {
	background-color: #E07A5F;
}

.pin-tail {
	position: relative;
	width: 11px;
	height: 11px;
	margin-top: -7px;
	transform: rotate(45deg);
}

.pin-tail-mine {
	background-color: #4E8A6B;
}

.pin-tail-plain {
	background-color: #FFFFFF;
	border-width: 1px;
	border-style: solid;
	border-color: #C6D9C8;
}

.pin-tail-warn {
	background-color: #E07A5F;
}

.pin-ico {
	width: 15px;
	height: 15px;
}

.pin-bang {
	font-size: 15px;
	font-weight: bold;
	color: #FFFFFF;
	font-family: HYSansBold;
}

.tree-card {
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 14px;
	right: 14px;
	bottom: 14px;
	background-color: #FFFFFF;
	border-radius: 24px;
	padding: 14px;
	box-shadow: 0px 6px 20px rgba(46, 107, 79, 0.12);
	z-index: 20;
}

.tc-row {
	display: flex;
	flex-direction: row;
}

.tc-thumb {
	display: flex;
	flex-direction: column;
	width: 64px;
	height: 64px;
	border-radius: 16px;
	background-color: #F4F9EE;
	align-items: center;
	justify-content: center;
}

.tc-img {
	width: 54px;
	height: 54px;
}

.tc-info {
	display: flex;
	flex-direction: column;
	flex: 1;
	margin-left: 12px;
	justify-content: center;
}

.tc-name {
	font-size: 14px;
	font-weight: bold;
	color: #22302A;
	font-family: HYSansBold;
}

.tc-meta {
	font-size: 10px;
	color: #9AA394;
	margin-top: 5px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.tc-tag-row {
	display: flex;
	flex-direction: row;
	margin-top: 7px;
}

.tc-tag {
	display: flex;
	flex-direction: row;
	height: 19px;
	border-radius: 10px;
	padding-left: 8px;
	padding-right: 8px;
	align-items: center;
	justify-content: center;
}

.tag-cream {
	background-color: #FBF0D9;
}

.tag-warn {
	background-color: #FBEDEA;
}

.tc-tag-t {
	font-size: 9px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.tc-tag-t-cream {
	color: #8A6A3B;
}

.tc-tag-t-warn {
	color: #B4553F;
}

.tc-btn {
	display: flex;
	flex-direction: column;
	height: 50px;
	border-radius: 25px;
	align-items: center;
	justify-content: center;
	margin-top: 13px;
}

.btn-main {
	background-color: #4E8A6B;
}

.btn-soft {
	background-color: #EAF4E6;
}

.btn-mute {
	background-color: #C3CFC2;
}

.tc-btn-t {
	font-size: 15px;
	font-weight: bold;
	font-family: HYSansBold;
}

.tc-btn-t-white {
	color: #FFFFFF;
}

.tc-btn-t-deep {
	color: #2E6B4F;
}
