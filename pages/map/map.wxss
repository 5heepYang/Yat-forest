.page {
	display: flex;
	flex-direction: column;
	height: 100vh;
	position: relative;
	background-color: #F4F4F4;
	color: #2A3A32;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.map-wrap {
	flex: 1;
	position: relative;
	overflow: hidden;
	background-color: #EDECE6;
}

.map-native {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	width: 100%;
	height: 100%;
}

.map-cover {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background-color: #F4F4F4;
}

.map-cover-ico {
	width: 118px;
	height: 118px;
	opacity: 0.55;
	mix-blend-mode: multiply;
}

/* 顶部检索牌 */
.float-top {
	position: absolute;
	left: 14px;
	right: 14px;
	top: 8px;
	z-index: 10;
	padding: 10px 12px 9px;
	background-color: #FFFFFF;
	border: 1px solid #F0F0F0;
	border-radius: 16px;
	box-shadow: 0 1px 2px rgba(34, 36, 31, 0.04), 0 6px 18px -12px rgba(34, 36, 31, 0.14);
}

/* 选点提示：墨色签条 */
.pick-bar {
	position: absolute;
	left: 14px;
	right: 14px;
	bottom: 22px;
	z-index: 12;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 10px 12px;
	background-color: #2A3A32;
	border-left: 3px solid #2A3A32;
	border-radius: 12px;
	box-shadow: 0 1px 2px rgba(34, 36, 31, 0.04), 0 6px 18px -12px rgba(34, 36, 31, 0.14);
}

.pick-texts {
	display: flex;
	flex-direction: column;
	flex: 1;
	padding-right: 10px;
}

.pick-t {
	font-size: 12px;
	color: #FFFFFF;
	letter-spacing: 0.4px;
}

.pick-sub {
	margin-top: 4px;
	font-size: 9.5px;
	color: #A9A392;
	letter-spacing: 0.2px;
}

.pick-cancel {
	flex-shrink: 0;
	padding: 5px 10px;
	border: 1px solid rgba(255, 255, 255, 0.42);
	border-radius: 12px;
}

.pick-cancel-t {
	font-size: 10px;
	color: #FFFFFF;
	letter-spacing: 0.3px;
}

/* 定位：方形工具钮 */
.loc-btn {
	position: absolute;
	right: 14px;
	bottom: 76px;
	z-index: 11;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 42px;
	height: 42px;
	background-color: #FFFFFF;
	border: 1px solid #F0F0F0;
	border-radius: 12px;
	box-shadow: 0 1px 2px rgba(34, 36, 31, 0.04), 0 6px 18px -12px rgba(34, 36, 31, 0.14);
}

.loc-ic {
	width: 19px;
	height: 19px;
	filter: grayscale(1) brightness(0.4);
}

/* 新增树木：墨实心签 */
.add-tree-btn {
	position: absolute;
	right: 14px;
	bottom: 22px;
	z-index: 11;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 42px;
	padding-left: 13px;
	padding-right: 14px;
	background-color: #2A3A32;
	border: 1px solid #F0F0F0;
	border-radius: 12px;
	box-shadow: 0 1px 2px rgba(34, 36, 31, 0.04), 0 6px 18px -12px rgba(34, 36, 31, 0.14);
}

.add-tree-ic {
	width: 13px;
	height: 13px;
	margin-right: 6px;
}

.add-tree-t {
	font-size: 12px;
	color: #FFFFFF;
	letter-spacing: 0.3px;
}

.tabbar-holder {
	height: calc(70px + env(safe-area-inset-bottom));
}