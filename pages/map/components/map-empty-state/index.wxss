/* 空状态：地图中央的白色小卡片，不遮挡可拖动的地图底图；入场淡入 + 轻微上移 */
.es-card {
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 50%;
	top: 42%;
	width: 220px;
	margin-left: -110px;
	background-color: rgba(255, 255, 255, 0.94);
	border-radius: 18px;
	padding: 18px 16px;
	align-items: center;
	box-shadow: 0px 4px 16px rgba(36, 90, 65, 0.12);
	z-index: 12;
	animation: es-in 0.28s cubic-bezier(0.22, 0.9, 0.35, 1) both;
}

@keyframes es-in {
	from {
		opacity: 0;
		transform: translateY(14px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

.es-ic {
	width: 26px;
	height: 26px;
}

.es-t {
	font-size: 14px;
	font-weight: bold;
	color: #1F2B24;
	margin-top: 8px;
	font-family: HYSansBold;
}

.es-sub {
	font-size: 11px;
	color: #9AA394;
	margin-top: 6px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.es-btn {
	display: flex;
	flex-direction: column;
	height: 34px;
	border-radius: 17px;
	background: linear-gradient(135deg, #4A8A66, #3E7D5C);
	box-shadow: 0 6px 14px rgba(62, 125, 92, 0.28);
	transition: transform 0.12s ease, opacity 0.12s ease;
	align-items: center;
	justify-content: center;
	padding-left: 16px;
	padding-right: 16px;
	margin-top: 12px;
}

.es-btn-t {
	font-size: 12px;
	color: #FFFFFF;
	font-weight: bold;
	letter-spacing: 0.4px;
	font-family: HYSansBold;
}

/* 组件默认样式隔离：按压反馈类需在组件内再声明一份 */
.hv-press {
	transform: scale(0.97);
	opacity: 0.92;
}
