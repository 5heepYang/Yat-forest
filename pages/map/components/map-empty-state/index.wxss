/* 空状态：地图中央一张小纸条 */
.es-card {
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 50%;
	top: 40%;
	width: 226px;
	margin-left: -113px;
	padding: 20px 18px 17px;
	align-items: center;
	background-color: #FFFFFF;
	border: 1px solid #F0F0F0;
	border-radius: 12px;
	box-shadow: 0 1px 2px rgba(34, 36, 31, 0.04), 0 6px 18px -12px rgba(34, 36, 31, 0.14);
	z-index: 12;
	animation: esIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes esIn {
	from {
		opacity: 0;
		transform: translateY(8px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

.es-ic {
	width: 18px;
	height: 18px;
	opacity: 0.4;
	filter: grayscale(1) brightness(0.4);
}

.es-t {
	margin-top: 11px;
	font-size: 12.5px;
	color: #2A3A32;
	letter-spacing: 0.8px;
}

.es-sub {
	margin-top: 7px;
	font-size: 10px;
	color: #8B908A;
	letter-spacing: 0.3px;
	line-height: 1.6;
	text-align: center;
}

.es-btn {
	display: flex;
	flex-direction: row;
	margin-top: 14px;
	padding-bottom: 2px;
	border-bottom: 1px solid #2A3A32;
}

.es-btn-t {
	font-size: 10px;
	color: #2A3A32;
	letter-spacing: 0.3px;
}

/* 组件样式隔离：按压反馈在组件内再声明一份 */
.hv-press {
	opacity: 0.78;
	transform: translateY(2px);
}