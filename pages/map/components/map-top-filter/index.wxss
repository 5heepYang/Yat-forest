/* 顶部搜索行 */
.search-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.search-pill {
	display: flex;
	flex-direction: row;
	flex: 1;
	height: 44px;
	background-color: #FFFFFF;
	border-radius: 22px;
	align-items: center;
	padding-left: 16px;
	box-shadow: 0px 2px 8px rgba(46, 107, 79, 0.06);
}

.ic-search {
	width: 15px;
	height: 15px;
	margin-right: 9px;
}

.search-ph {
	font-size: 12px;
	color: #B4BCAF;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.search-input {
	flex: 1;
	font-size: 12px;
	color: #22302A;
	font-family: HYSans;
}

/* 筛选 Tab */
.chip-row {
	display: flex;
	flex-direction: row;
	margin-top: 14px;
}

.chip {
	display: flex;
	flex-direction: row;
	height: 28px;
	border-radius: 14px;
	background-color: #FFFFFF;
	align-items: center;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 8px;
	transition: background-color 0.18s ease;
}

.chip-on {
	background-color: #4E8A6B;
}

.chip-t {
	font-size: 11px;
	color: #5C6B60;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.chip-t-on {
	color: #FFFFFF;
	font-weight: bold;
}
