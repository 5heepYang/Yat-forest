.search-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

/* 搜索：只留一条底线，不要胶囊 */
.search-pill {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1;
	height: 30px;
	border-bottom: 1px solid rgba(34, 36, 31, 0.3);
}

.ic-search {
	width: 13px;
	height: 13px;
	opacity: 0.5;
	filter: grayscale(1) brightness(0.5);
}

.search-input {
	flex: 1;
	height: 30px;
	margin-left: 8px;
	font-size: 12px;
	color: #2A3A32;
	letter-spacing: 0.4px;
}

.search-ph {
	color: #A9A392;
	font-size: 12px;
	letter-spacing: 0.4px;
}

/* 筛选：方角细框签 */
.chip-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 2px;
}

.chip {
	margin-right: 6px;
	margin-top: 7px;
	padding: 4px 9px 5px;
	border: 1px solid rgba(34, 36, 31, 0.26);
	border-radius: 12px;
}

.chip-on {
	background-color: #2A3A32;
	border-color: #2A3A32;
}

.chip-t {
	font-size: 10.5px;
	color: #47514B;
	letter-spacing: 0.3px;
}

.chip-t-on {
	color: #FFFFFF;
}

/* 组件样式隔离：按压反馈在组件内再声明一份 */
.hv-press {
	opacity: 0.78;
	transform: translateY(2px);
}