/* 遮罩：只盖地图区域，点击关闭 */
.tc-mask {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(20, 18, 14, 0.52);
	z-index: 15;
	opacity: 0;
	transition: opacity 0.22s ease;
}

.tc-mask-on {
	opacity: 1;
}

/* 详情卡：贴底纸片，上滑入场 */
.tree-card {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 16;
	display: flex;
	flex-direction: column;
	max-height: 82%;
	overflow-y: auto;
	padding: 20px 18px 16px;
	background-color: #FFFFFF;
	border-top: none;
	border-radius: 24px 24px 0 0;
	transform: translateY(102%);
	transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.tc-on {
	transform: translateY(0);
}

.tree-card::before {
	content: "";
	position: absolute;
	left: 50%;
	top: 8px;
	margin-left: -17px;
	width: 34px;
	height: 3px;
	border-top: 1px solid #EFEFEF;
	border-bottom: 1px solid #EFEFEF;
}

.tc-close {
	position: absolute;
	right: 12px;
	top: 10px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 30px;
	height: 30px;
}

.tc-close-t {
	font-size: 19px;
	color: #8B908A;
	line-height: 1;
}

.tc-row {
	display: flex;
	flex-direction: row;
	padding-top: 6px;
	padding-right: 26px;
}

.tc-thumb {
	width: 78px;
	height: 78px;
	flex-shrink: 0;
	overflow: hidden;
	background-color: #F2F4F0;
	border: none;
	border-radius: 14px;
}

.tc-img {
	width: 100%;
	height: 100%;
}

.tc-info {
	display: flex;
	flex-direction: column;
	flex: 1;
	padding-left: 12px;
}

.tc-name {
	font-size: 19px;
	color: #2A3A32;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 800;
	letter-spacing: -0.3px;
}

.tc-meta {
	margin-top: 6px;
	font-size: 12px;
	color: #8B908A;
	letter-spacing: 0;
}

.tc-tag-row {
	display: flex;
	flex-direction: row;
	margin-top: 8px;
}

.tc-tag {
	padding: 2px 7px 3px;
	border: 1px solid rgba(34, 36, 31, 0.36);
	border-radius: 12px;
}

.tag-cream {
	border-color: rgba(140, 124, 94, 0.55);
}

.tag-warn {
	border-color: rgba(58, 74, 70, 0.6);
}

.tc-tag-t {
	font-size: 11px;
	letter-spacing: 0;
	font-weight: 600;
}

.tc-tag-t-cream {
	color: #E0A526;
}

.tc-tag-t-warn {
	color: #2A3A32;
}

/* 三格台账：居中，无分隔竖线 */
.tc-stats {
	display: flex;
	flex-direction: row;
	margin-top: 16px;
	padding: 14px 0;
	background-color: #F7F7F5;
	border-radius: 14px;
	border-top: none;
	border-bottom: none;
}

.tc-stat {
	display: flex;
	flex-direction: column;
	align-items: center;
	flex: 1;
}

.tc-stat-label {
	font-size: 11.5px;
	color: #8B908A;
	letter-spacing: 0;
}

.tc-stat-value {
	margin-top: 5px;
	font-size: 16px;
	color: #2A3A32;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	letter-spacing: 0;
}

.tc-desc {
	margin-top: 14px;
	padding: 12px 14px;
	background-color: #F7F7F5;
	border-radius: 12px;
}

.tc-desc-warn {
	border-left-color: #2A3A32;
}

.tc-desc-t {
	font-size: 12.5px;
	color: #47514B;
	line-height: 1.65;
	letter-spacing: 0;
}

/* 主按钮 / 次按钮 / 不可用 */
.tc-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 50px;
	border: none;
	border-radius: 14px;
}

.btn-main {
	background-color: #2A3A32;
}

.btn-soft {
	background-color: #F2F2F0;
}

.btn-mute {
	background-color: #F7F7F7;
}

.tc-btn-t {
	font-size: 15px;
	color: #47514B;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 600;
	letter-spacing: 0;
}

.tc-btn-t-deep {
	color: #2A3A32;
}

.tc-btn-t-white {
	color: #FFFFFF;
}

.tc-owner {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-top: 12px;
}

.tc-owner-t {
	font-size: 12.5px;
	color: #6E7A70;
	letter-spacing: 0;
	text-decoration: none;
}

.tc-hazard {
	display: flex;
	align-items: center;
	justify-content: center;
	margin-top: 14px;
	padding: 12px 14px;
	background-color: #F7F2EC;
	border-radius: 12px;
	border-top: none;
}

.tc-hazard-ic {
	width: 14px;
	height: 14px;
	margin-right: 6px;
	border: 1px solid #2A3A32;
	border-radius: 7px;
	font-size: 9px;
	color: #2A3A32;
	text-align: center;
	line-height: 12px;
}

.tc-hazard-t {
	font-size: 12.5px;
	color: #5E5045;
	letter-spacing: 0;
}

/* 组件样式隔离：按压反馈在组件内再声明一份 */
.hv-press {
	opacity: 0.78;
	transform: translateY(2px);
}