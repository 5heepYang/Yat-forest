/* 遮罩 */
.um-mask {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(20, 18, 14, 0.52);
	z-index: 25;
	opacity: 0;
	transition: opacity 0.22s ease;
}

.um-mask-on {
	opacity: 1;
}

/* 弹窗：一张居中的纸牌 */
.um-card {
	position: absolute;
	left: 20px;
	right: 20px;
	top: 50%;
	z-index: 26;
	display: flex;
	flex-direction: column;
	max-height: 78vh;
	padding: 17px 16px 15px;
	background-color: #FFFFFF;
	border: 1px solid #F0F0F0;
	border-radius: 16px;
	box-shadow: 0 1px 2px rgba(34, 36, 31, 0.04), 0 6px 18px -12px rgba(34, 36, 31, 0.14);
	transform: translateY(-50%) scale(0.97);
	opacity: 0;
	transition: transform 0.26s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
}

.um-on {
	opacity: 1;
	transform: translateY(-50%) scale(1);
}

.um-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-bottom: 14px;
}

.um-title {
	font-size: 20px;
	color: #2A3A32;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 800;
	letter-spacing: -0.2px;
}

.um-close {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 28px;
	height: 28px;
	margin-right: -6px;
}

.um-close-t {
	font-size: 19px;
	color: #8B908A;
	line-height: 1;
}

/* 表单 */
.um-body {
	height: 420px;
	max-height: 54vh;
	overflow-y: auto;
}

.um-field {
	margin-top: 16px;
	padding: 0;
	border-bottom: none;
}

.um-label {
	display: block;
	margin-bottom: 7px;
	font-size: 12px;
	color: #8B908A;
	font-weight: 500;
	letter-spacing: 0;
}

.um-req {
	color: #2A3A32;
}

.um-input {
	width: 100%;
	height: 46px;
	padding: 0 14px;
	font-size: 14px;
	color: #2A3A32;
	background-color: #F2F2F0;
	border-radius: 12px;
	box-sizing: border-box;
}

.um-ph {
	color: #9AA096;
	font-size: 14px;
}

.um-photo {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 136px;
	margin-top: 4px;
	overflow: hidden;
	background-color: #EFF2EC;
	border: none;
	border-radius: 14px;
}

.um-photo-img {
	width: 100%;
	height: 100%;
}

.um-photo-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
}

.um-photo-ic {
	width: 22px;
	height: 22px;
	opacity: 0.42;
	filter: grayscale(1) brightness(0.4);
}

.um-photo-t {
	margin-top: 8px;
	font-size: 12.5px;
	color: #6E7A70;
	letter-spacing: 0;
}

.um-photo-tip {
	display: block;
	margin-top: 8px;
	font-size: 11.5px;
	color: #6E7A70;
	letter-spacing: 0;
}

.um-loc-row {
	margin-top: 4px;
}

.um-loc {
	display: flex;
	flex-direction: column;
}

.um-loc-t {
	font-size: 14px;
	color: #2A3A32;
	font-weight: 600;
	letter-spacing: 0;
}

.um-loc-coord {
	margin-top: 5px;
	font-size: 11.5px;
	color: #8B908A;
	letter-spacing: 0;
}

.um-loc-hint {
	margin-top: 4px;
	font-size: 11.5px;
	color: #8B908A;
}

.um-textarea {
	width: 100%;
	height: 78px;
	padding: 12px 14px;
	font-size: 14px;
	color: #2A3A32;
	line-height: 1.6;
	background-color: #F2F2F0;
	border-radius: 12px;
	box-sizing: border-box;
}

.um-submit {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	height: 50px;
	margin-top: 20px;
	background-color: #2A3A32;
	border-radius: 14px;
}

.um-submit-warn {
	background-color: #2A3A32;
}

.um-submit-t {
	font-size: 15px;
	color: #FFFFFF;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	letter-spacing: 0.5px;
}

/* 结果态 */
.um-result {
	display: flex;
	flex-direction: row;
	padding-top: 14px;
}

.um-result-img {
	width: 84px;
	height: 84px;
	flex-shrink: 0;
	background-color: #F1EDDF;
	border: 1px solid rgba(34, 36, 31, 0.3);
}

.um-result-info {
	display: flex;
	flex-direction: column;
	flex: 1;
	padding-left: 12px;
}

.um-result-name {
	font-size: 15px;
	color: #2A3A32;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	letter-spacing: 0.6px;
	line-height: 1.4;
}

.um-result-species-row {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	margin-top: 8px;
}

.um-result-label {
	font-size: 11.5px;
	color: #8B908A;
	letter-spacing: 0;
}

.um-result-species {
	font-size: 13px;
	color: #2A3A32;
	font-weight: 600;
	letter-spacing: 0;
}

.um-result-meta {
	font-size: 12px;
	color: #8B908A;
	letter-spacing: 0;
}

.um-result-hint {
	font-size: 11.5px;
	color: #8B908A;
	line-height: 1.6;
}

.um-result-done {
	height: 46px;
	line-height: 46px;
	font-size: 14px;
	color: #FFFFFF;
	font-weight: 700;
	background-color: #2A3A32;
	border-radius: 14px;
	text-align: center;
}

.um-result-fail {
	height: 46px;
	line-height: 46px;
	font-size: 13px;
	color: #6E7A70;
	background-color: #F2F2F0;
	border-radius: 14px;
	text-align: center;
}

/* 组件样式隔离：按压反馈在组件内再声明一份 */
.hv-press {
	opacity: 0.78;
	transform: translateY(2px);
}