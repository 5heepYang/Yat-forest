/* 新增树木弹窗：遮罩 + 底部卡片，风格与树木详情卡片一致；上滑 + 淡入淡出 */
.um-mask {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(34, 48, 42, 0.35);
	z-index: 25;
	opacity: 0;
	transition: opacity 0.24s ease;
}

.um-mask-on {
	opacity: 1;
}

.um-card {
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 14px;
	right: 14px;
	bottom: 14px;
	background-color: #FFFFFF;
	border-radius: 24px;
	padding: 16px 14px 14px;
	box-shadow: 0px 6px 20px rgba(46, 107, 79, 0.12);
	z-index: 26;
	opacity: 0;
	transform: translateY(48px);
	transition: transform 0.26s cubic-bezier(0.22, 0.9, 0.35, 1), opacity 0.26s ease;
}

.um-on {
	opacity: 1;
	transform: translateY(0);
}

.um-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.um-title {
	font-size: 16px;
	font-weight: bold;
	color: #22302A;
	font-family: HYSansBold;
}

.um-close {
	display: flex;
	flex-direction: column;
	width: 26px;
	height: 26px;
	border-radius: 13px;
	background-color: #F3F9EF;
	align-items: center;
	justify-content: center;
}

.um-close-t {
	font-size: 16px;
	line-height: 16px;
	color: #9AA394;
}

.um-body {
	display: flex;
	flex-direction: column;
	max-height: 56vh;
	margin-top: 6px;
}

.um-field {
	display: flex;
	flex-direction: column;
	margin-top: 12px;
}

.um-label {
	font-size: 12px;
	color: #5C6B60;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.um-req {
	color: #E07A5F;
}

.um-input {
	height: 40px;
	background-color: #F6FAF2;
	border-radius: 12px;
	padding: 0 12px;
	margin-top: 6px;
	font-size: 13px;
	color: #22302A;
	font-family: HYSans;
}

.um-ph {
	font-size: 12px;
	color: #B4BCAF;
	font-family: HYSans;
}

/* 照片：未选时是虚线占位，选完显示预览 */
.um-photo {
	display: flex;
	flex-direction: column;
	margin-top: 6px;
	border-radius: 12px;
	overflow: hidden;
}

.um-photo-empty {
	display: flex;
	flex-direction: column;
	height: 96px;
	background-color: #F6FAF2;
	border-width: 1px;
	border-style: dashed;
	border-color: #C6D9C8;
	border-radius: 12px;
	align-items: center;
	justify-content: center;
}

.um-photo-ic {
	width: 24px;
	height: 24px;
}

.um-photo-t {
	font-size: 11px;
	color: #9AA394;
	margin-top: 6px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.um-photo-img {
	width: 100%;
	height: 140px;
	border-radius: 12px;
}

.um-loc-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 6px;
}

.um-loc {
	display: flex;
	flex-direction: column;
	flex: 1;
	background-color: #F6FAF2;
	border-radius: 12px;
	padding: 10px 12px;
}

.um-pick {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 44px;
	border-radius: 12px;
	background-color: #EAF4E6;
	padding-left: 12px;
	padding-right: 12px;
	margin-left: 8px;
}

.um-pick-t {
	font-size: 12px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

.um-loc-hint {
	font-size: 10px;
	color: #9AA394;
	margin-top: 4px;
	font-family: HYSans;
}

.um-loc-t {
	font-size: 13px;
	color: #22302A;
	font-family: HYSans;
}

.um-loc-coord {
	font-size: 10px;
	color: #9AA394;
	margin-top: 4px;
	font-family: HYSans;
}

.um-textarea {
	width: auto;
	height: 64px;
	background-color: #F6FAF2;
	border-radius: 12px;
	padding: 10px 12px;
	margin-top: 6px;
	font-size: 13px;
	color: #22302A;
	font-family: HYSans;
}

.um-submit {
	display: flex;
	flex-direction: column;
	height: 46px;
	border-radius: 23px;
	background-color: #4E8A6B;
	align-items: center;
	justify-content: center;
	margin-top: 14px;
}

.um-submit-t {
	font-size: 15px;
	font-weight: bold;
	color: #FFFFFF;
	font-family: HYSansBold;
}
