<block wx:if="{{render}}">
	<view class="um-mask {{anim ? 'um-mask-on' : ''}}" bindtap="onClose"></view>

	<view class="um-card {{anim ? 'um-on' : ''}}">
		<view class="um-head">
			<text class="um-title">新增树木</text>
			<view class="um-close" bindtap="onClose">
				<text class="um-close-t">×</text>
			</view>
		</view>

		<scroll-view class="um-body" scroll-y>
			<view class="um-field">
				<text class="um-label">树木名称 <text class="um-req">*</text></text>
				<input class="um-input" value="{{name}}" placeholder="请填写区域和名称，用·连接，例如：图书馆西侧·樟树" placeholder-class="um-ph" bindinput="onNameInput" />
			</view>

			<view class="um-field">
				<text class="um-label">树种 <text class="um-req">*</text></text>
				<input class="um-input" value="{{species}}" placeholder="例如：大王椰子" placeholder-class="um-ph" bindinput="onSpeciesInput" />
			</view>

			<view class="um-field">
				<text class="um-label">树龄</text>
				<input class="um-input" value="{{age}}" type="text" placeholder="例如 35（年），不清楚可留空" placeholder-class="um-ph" bindinput="onAgeInput" />
			</view>

			<view class="um-field">
				<text class="um-label">现场照片 <text class="um-req">*</text></text>
				<view class="um-photo" bindtap="onChooseImage">
					<image wx:if="{{image}}" class="um-photo-img" src="{{image}}" mode="aspectFill"></image>
					<view wx:else class="um-photo-empty">
						<image class="um-photo-ic" src="/static/ui/camera.png"></image>
						<text class="um-photo-t">拍摄 / 选择现场照片</text>
					</view>
				</view>
			</view>

			<view class="um-field">
				<text class="um-label">位置 <text class="um-req">*</text></text>
				<view class="um-loc-row">
					<view class="um-loc">
						<text class="um-loc-t">{{location ? '已选位置' : '还没选位置'}}</text>
						<text class="um-loc-coord" wx:if="{{location}}">{{locationText}}</text>
						<text class="um-loc-hint" wx:else>默认用地图中心，也可以在地图上点一下</text>
					</view>
					<view class="um-pick" bindtap="onPickLocation">
						<text class="um-pick-t">去地图点选</text>
					</view>
				</view>
			</view>

			<view class="um-field">
				<text class="um-label">描述（选填）</text>
				<textarea class="um-textarea" value="{{description}}" placeholder="介绍树木位置、状态等" placeholder-class="um-ph" bindinput="onDescInput"></textarea>
			</view>
		</scroll-view>

		<view class="um-submit" bindtap="onSubmit">
			<text class="um-submit-t">提交新增</text>
		</view>
	</view>
</block>
