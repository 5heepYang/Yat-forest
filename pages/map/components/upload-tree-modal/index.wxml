<block wx:if="{{render}}">
	<view class="um-mask {{anim ? 'um-mask-on' : ''}}" bindtap="onMaskTap"></view>

	<!-- 结果态：AI 识别完生成的树卡片 -->
	<view wx:if="{{result}}" class="um-card {{anim ? 'um-on' : ''}}">
		<view class="um-head">
			<text class="um-title">{{result.ok ? '树卡片' : '没认出是树'}}</text>
			<view class="um-close" bindtap="onResultClose">
				<text class="um-close-t">×</text>
			</view>
		</view>

		<view class="um-result">
			<image wx:if="{{result.image}}" class="um-result-img" src="{{result.image}}" mode="aspectFill"></image>

			<view class="um-result-info">
				<text class="um-result-name">{{result.name}}</text>

				<block wx:if="{{result.ok}}">
					<view class="um-result-species-row">
						<text class="um-result-label">树种</text>
						<text class="um-result-species">{{result.species}}</text>
					</view>
					<text wx:if="{{result.age}}" class="um-result-meta">树龄 {{result.age}} 年</text>
					<text wx:if="{{result.aiDown}}" class="um-result-hint">品种识别暂时不可用，已按「未识别」记录</text>
					<text wx:elif="{{result.reason}}" class="um-result-hint">{{result.reason}}</text>
					<text class="um-result-done">已生成树卡片，并标注在地图上</text>
				</block>

				<block wx:else>
					<text class="um-result-fail">{{result.reason}}</text>
					<text class="um-result-hint">换一张能看清树木主体的照片再试，画面里要是树，不是书本或人。</text>
				</block>
			</view>
		</view>

		<view wx:if="{{result.ok}}" class="um-submit" bindtap="onResultClose">
			<text class="um-submit-t">知道了</text>
		</view>
		<view wx:else class="um-submit um-submit-warn" bindtap="onRetake">
			<text class="um-submit-t">重拍一张</text>
		</view>
	</view>

	<!-- 表单态 -->
	<view wx:else class="um-card {{anim ? 'um-on' : ''}}">
		<view class="um-head">
			<text class="um-title">新增树木</text>
			<view class="um-close" bindtap="onClose">
				<text class="um-close-t">×</text>
			</view>
		</view>

		<scroll-view class="um-body" scroll-y>
			<view class="um-field">
				<text class="um-label">树木名称 <text class="um-req">*</text></text>
				<input class="um-input" value="{{name}}" placeholder="给它起个名，例如：图书馆西侧·那棵大树" placeholder-class="um-ph" bindinput="onNameInput" />
			</view>

			<view class="um-field">
				<text class="um-label">现场照片 <text class="um-req">*</text></text>
				<view class="um-photo" bindtap="onChooseImage">
					<image wx:if="{{image}}" class="um-photo-img" src="{{image}}" mode="aspectFill"></image>
					<view wx:else class="um-photo-empty">
						<image class="um-photo-ic" src="/static/ui/camera.png"></image>
						<text class="um-photo-t">拍摄 / 选择现场照片</text>
					</view>
				</view>
				<text class="um-photo-tip">照片会识别树种、判断是不是树</text>
			</view>

			<view class="um-field">
				<text class="um-label">位置 <text class="um-req">*</text></text>
				<view class="um-loc-row">
					<view class="um-loc">
						<text class="um-loc-t">{{location ? '已在地图选点' : '还没选位置'}}</text>
						<text class="um-loc-coord" wx:if="{{location}}">{{locationText}}</text>
						<text class="um-loc-hint" wx:else>请关闭弹窗后重新点「新增树木」选点</text>
					</view>
				</view>
			</view>

			<view class="um-field">
				<text class="um-label">树龄（选填）</text>
				<input class="um-input" value="{{age}}" type="text" placeholder="例如 35，不清楚可留空" placeholder-class="um-ph" bindinput="onAgeInput" />
			</view>

			<view class="um-field">
				<text class="um-label">描述（选填）</text>
				<textarea class="um-textarea" value="{{description}}" placeholder="介绍树木位置、状态等" placeholder-class="um-ph" bindinput="onDescInput"></textarea>
			</view>
		</scroll-view>

		<view class="um-submit" bindtap="onSubmit">
			<text class="um-submit-t">提交</text>
		</view>
	</view>
</block>
