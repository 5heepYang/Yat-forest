<template>
	<view class="page">
		<nav-bar title="森友地图" :subtitle="'南校园 · ' + store.trees.length.toFixed(0) + ' 棵树在册'">
			<view class="icon-btn" @click="onAddTree">
				<image class="icon-18" src="/static/ui/plus.png"></image>
			</view>
		</nav-bar>

		<view class="map-wrap">
			<view class="map-bg"></view>
			<view class="blob blob-1"></view>
			<view class="blob blob-2"></view>
			<view class="blob blob-3"></view>
			<view class="road road-1"></view>
			<view class="road road-2"></view>
			<view class="lake"></view>
			<view class="bld bld-1"></view>
			<view class="bld bld-2"></view>
			<view class="bld bld-3"></view>
			<view class="dot dot-1"></view>
			<view class="dot dot-2"></view>
			<view class="dot dot-3"></view>

			<view v-for="t in visibleTrees" :key="t.treeId" class="pin" :style="pinStyle(t)" @click="selectTree(t)">
				<view class="pin-head" :class="pinClass(t)">
					<text v-if="t.status == 'hazard'" class="pin-bang">!</text>
					<image v-else :src="pinIcon(t)" class="pin-ico"></image>
				</view>
				<view class="pin-tail" :class="pinTailClass(t)"></view>
			</view>

			<view class="float-top">
				<view class="search-row">
					<view class="search-pill" @click="onSearch">
						<image class="ic-search" src="/static/ui/search.png"></image>
						<text class="search-ph">搜树种 / 认养人 / 楼栋</text>
					</view>
					<view class="filter-btn" @click="onSearch">
						<image class="ic-sliders" src="/static/ui/sliders.png"></image>
					</view>
				</view>
				<view class="chip-row">
					<view v-for="f in filters" :key="f.key" :class="filter == f.key ? 'chip chip-on' : 'chip'"
						@click="setFilter(f.key)">
						<view v-if="filter != f.key && f.key == 'mine'" class="chip-dot"></view>
						<view v-if="filter != f.key && f.key == 'free'" class="chip-ring"></view>
						<text :class="filter == f.key ? 'chip-t chip-t-on' : 'chip-t'">{{ f.label }}</text>
					</view>
				</view>
			</view>

			<view class="hint-pill">
				<text class="hint-t">附近 {{ unownedCount() }} 棵可认养</text>
			</view>

			<view class="tree-card" v-if="showCard">
				<view class="tc-row">
					<view class="tc-thumb">
						<image class="tc-img" src="/static/illus/palm.png"></image>
					</view>
					<view class="tc-info">
						<text class="tc-name">{{ selected.name }}</text>
						<text class="tc-meta">{{ selected.species }} · 树龄 {{ selected.age }} · 距你 {{ selected.distance.toFixed(0) }} m</text>
						<view class="tc-tag-row">
							<view class="tc-tag" :class="tagBg">
								<text class="tc-tag-t" :class="tagColor">{{ tagText }}</text>
							</view>
						</view>
					</view>
				</view>
				<view class="tc-btn" :class="btnBg" @click="onCardAction">
					<text class="tc-btn-t" :class="btnColor">{{ btnText }}</text>
				</view>
			</view>
		</view>

		<app-tabbar active="map"></app-tabbar>
	</view>
</template>

<script setup>
	import NavBar from '@/components/nav-bar.uvue'
	import AppTabbar from '@/components/app-tabbar.uvue'
	import { Tree } from '@/common/model.uts'
	import { emptyTree } from '@/common/mock.uts'
	import { store, adoptTree, unownedCount } from '@/common/store.uts'
	import { ADOPT_COST } from '@/common/theme.uts'
	import { toast } from '@/common/util.uts'

	type FilterOpt = {
		key : string,
		label : string
	}

	const filters : Array<FilterOpt> = [
		{ key: 'all', label: '全部' },
		{ key: 'mine', label: '我认养的' },
		{ key: 'owned', label: '已认养' },
		{ key: 'free', label: '待认养' }
	]

	const filter = ref<string>('all')
	const showCard = ref<boolean>(false)
	const selected = ref<Tree>(emptyTree())

	const visibleTrees = computed(() : Array<Tree> => {
		const out : Array<Tree> = []
		let i = 0
		while (i < store.trees.length) {
			const t = store.trees[i]
			if (filter.value == 'all') {
				out.push(t)
			} else if (filter.value == 'mine') {
				if (t.ownerId == store.user.userId) {
					out.push(t)
				}
			} else if (filter.value == 'owned') {
				if (t.ownerId != '') {
					out.push(t)
				}
			} else {
				if (t.ownerId == '') {
					out.push(t)
				}
			}
			i++
		}
		return out
	})

	const tagText = computed(() : string => {
		const t = selected.value
		if (t.status == 'hazard') {
			return '隐患预警 · 待后勤处理'
		}
		if (t.ownerId == '') {
			return '待认养 · 可立即认养'
		}
		if (t.ownerId == store.user.userId) {
			return '我认养的 · 可去养护'
		}
		return '已认养 · ' + t.ownerName
	})

	const tagBg = computed(() : string => {
		return selected.value.status == 'hazard' ? 'tag-warn' : 'tag-cream'
	})

	const tagColor = computed(() : string => {
		return selected.value.status == 'hazard' ? 'tc-tag-t-warn' : 'tc-tag-t-cream'
	})

	const btnText = computed(() : string => {
		const t = selected.value
		if (t.ownerId == store.user.userId) {
			return '已认养 · 去给它浇水'
		}
		if (t.status == 'hazard') {
			return '隐患处理中 · 暂不可认养'
		}
		return '消耗 ' + ADOPT_COST.toFixed(0) + ' 积分认养'
	})

	const btnBg = computed(() : string => {
		const t = selected.value
		if (t.ownerId == store.user.userId) {
			return 'btn-soft'
		}
		return t.status == 'hazard' ? 'btn-mute' : 'btn-main'
	})

	const btnColor = computed(() : string => {
		return selected.value.ownerId == store.user.userId ? 'tc-btn-t-deep' : 'tc-btn-t-white'
	})

	function pinStyle(t : Tree) : string {
		return 'left:' + t.posX.toFixed(0) + '%;top:' + t.posY.toFixed(0) + '%'
	}

	function pinClass(t : Tree) : string {
		if (t.status == 'hazard') {
			return 'pin-head-warn'
		}
		return t.ownerId == store.user.userId ? 'pin-head-mine' : 'pin-head-plain'
	}

	function pinTailClass(t : Tree) : string {
		if (t.status == 'hazard') {
			return 'pin-tail-warn'
		}
		return t.ownerId == store.user.userId ? 'pin-tail-mine' : 'pin-tail-plain'
	}

	function pinIcon(t : Tree) : string {
		if (t.ownerId == store.user.userId) {
			return '/static/illus/tree-white.png'
		}
		if (t.ownerId != '') {
			return '/static/illus/tree-deep.png'
		}
		return '/static/illus/tree-sage.png'
	}

	function setFilter(k : string) {
		filter.value = k
	}

	function selectTree(t : Tree) {
		selected.value = t
		showCard.value = true
	}

	function onCardAction() {
		const t = selected.value
		if (t.ownerId == store.user.userId) {
			uni.reLaunch({
				url: '/pages/tree/tree'
			})
			return
		}
		const err = adoptTree(t.treeId)
		if (err != '') {
			toast(err)
			return
		}
		showCard.value = false
		toast('认养成功！去「林地」给它浇水吧')
	}

	function onAddTree() {
		const n = store.trees.length + 1
		const tree : Tree = {
			treeId: 't_' + (100 + n).toFixed(0),
			name: '新上报点位 · 待鉴定 ' + n.toFixed(0),
			species: '待识别',
			posX: 20 + Math.random() * 55,
			posY: 26 + Math.random() * 34,
			ownerId: '', ownerName: '', level: 0, growthScore: 0,
			status: 'normal', hazardText: '', age: '未知', distance: 520
		}
		store.trees.push(tree)
		toast('已新增待认养点位，队员 A 采集实拍后可直接替换')
	}

	function onSearch() {
		toast('1.0 骨架：搜索框已就位，队员 A 可在此接入树名检索')
	}
</script>

