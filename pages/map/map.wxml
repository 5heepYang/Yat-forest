<view class="page {{navAnim}}">
	<nav-bar title="森友地图" subtitle="{{subtitle}}"></nav-bar>

	<view class="map-wrap">
		<map
			id="campusMap"
			class="map-native"
			latitude="{{center.latitude}}"
			longitude="{{center.longitude}}"
			scale="{{scale}}"
			markers="{{markers}}"
			show-location="{{userReal}}"
			bindmarkertap="onMarkerTap"
			bindtap="onMapTap"
		></map>

		<view class="map-cover" wx:if="{{!mapReady}}">
			<image class="map-cover-ico" src="/static/illus/tree-sage.png"></image>
		</view>

		<map-top-filter
			class="float-top"
			filters="{{filters}}"
			active="{{filter}}"
			keyword="{{keyword}}"
			bind:filterchange="setFilter"
			bind:keywordchange="onKeywordChange"
		></map-top-filter>

		<map-empty-state
			show="{{showEmpty}}"
			bind:reset="onResetView"
		></map-empty-state>

		<view class="pick-bar" wx:if="{{pickMode}}">
			<view class="pick-texts">
				<text class="pick-t">先在地图上点一下树木位置</text>
				<text class="pick-sub">点完会自动弹出树木信息表</text>
			</view>
			<view class="pick-cancel" bindtap="onPickCancel">
				<text class="pick-cancel-t">取消</text>
			</view>
		</view>

		<view class="loc-btn" wx:if="{{!showCard && !showUpload && !pickMode}}" bindtap="onLocate">
			<image class="loc-ic" src="/pages/map/assets/loc-green.png"></image>
		</view>

		<view class="add-tree-btn" wx:if="{{!showCard && !showUpload && !pickMode}}" bindtap="onAddTree">
			<image class="add-tree-ic" src="/pages/map/assets/plus-white.png"></image>
			<text class="add-tree-t">新增树木</text>
		</view>

		<tree-detail-sheet
			show="{{showCard}}"
			tree="{{sel}}"
			bind:action="onCardAction"
			bind:hazard="onCardHazard"
			bind:owner="onViewOwner"
			bind:close="onCardClose"
		></tree-detail-sheet>

		<upload-tree-modal
			show="{{showUpload}}"
			location="{{uploadLoc}}"
			draft="{{uploadDraft}}"
			result="{{uploadResult}}"
			bind:close="onUploadClose"
			bind:draftchange="onUploadDraft"
			bind:submit="onUploadSubmit"
			bind:retake="onUploadRetake"
			bind:resultclose="onUploadResultClose"
		></upload-tree-modal>
	</view>

	<view class="tabbar-holder"></view>
</view>
