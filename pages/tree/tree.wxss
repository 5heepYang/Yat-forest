.page {
	display: flex;
	flex-direction: column;
	height: 100vh;
	position: relative;
	background-color: #FAF7F0;
	font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "PingFang SC", "MiSans", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
}

.body {
	flex: 1;
	height: 0;
}

.main-card {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 22px;
	margin: 6px 16px 0 16px;
	padding: 16px;
	box-shadow: 0 1px 2px rgba(31, 43, 36, 0.04), 0 8px 24px rgba(36, 90, 65, 0.08);
	animation: riseIn 260ms cubic-bezier(0.22, 0.9, 0.35, 1) 1 backwards;
}

.mc-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.mc-left {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.mc-name {
	font-size: 14px;
	font-weight: bold;
	color: #1F2B24;
	font-family: HYSansBold;
}

.mc-meta {
	font-size: 10px;
	color: #9AA394;
	margin-top: 5px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.lv-pill {
	display: flex;
	flex-direction: row;
	height: 24px;
	border-radius: 12px;
	background-color: #E9F2E4;
	padding-left: 10px;
	padding-right: 10px;
	align-items: center;
	justify-content: center;
}

.lv-t {
	font-size: 10px;
	font-weight: bold;
	color: #3E7D5C;
	font-family: HYSansBold;
}

.stage {
	display: flex;
	flex-direction: column;
	height: 190px;
	align-items: center;
	justify-content: center;
	margin-top: 4px;
	position: relative;
}

/* 舞台式同心光晕：让树插画有一个"被注视"的中心，纯装饰不占位 */
.stage::before {
	content: "";
	position: absolute;
	left: 50%;
	top: 50%;
	width: 180px;
	height: 180px;
	margin-left: -90px;
	margin-top: -90px;
	border-radius: 90px;
	background: radial-gradient(circle, #E1EFD9 0%, #EDF5E7 58%, transparent 72%);
	z-index: 0;
}

.stage-img {
	width: 168px;
	height: 168px;
	position: relative;
	z-index: 1;
}

.weather-pill {
	display: flex;
	flex-direction: row;
	position: absolute;
	right: 0;
	top: 34px;
	height: 26px;
	border-radius: 13px;
	background-color: #FFFFFF;
	padding-left: 11px;
	padding-right: 11px;
	align-items: center;
	justify-content: center;
	box-shadow: 0px 2px 8px rgba(36, 90, 65, 0.10);
	z-index: 2;
	animation: floaty 3s ease-in-out infinite;
}

.weather-t {
	font-size: 10px;
	color: #5C6B60;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.growth-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 2px;
}

.growth-lb {
	font-size: 11px;
	font-weight: bold;
	color: #1F2B24;
	font-family: HYSansBold;
}

.growth-hint {
	font-size: 10px;
	color: #9AA394;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.gbar {
	height: 8px;
	background-color: #EDF2E7;
	border-radius: 4px;
	margin-top: 9px;
	overflow: hidden;
}

.gbar-in {
	height: 8px;
	background: linear-gradient(90deg, #5FA97F, #3E7D5C);
	border-radius: 4px;
	animation: barGrow 600ms cubic-bezier(0.22, 0.9, 0.35, 1) 1 both;
}

.act-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	margin-top: 14px;
}

.act-col {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 31%;
}

.act-btn {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 40px;
	border-radius: 16px;
	background-color: #F2F7EC;
	align-items: center;
	justify-content: center;
	transition: transform 0.12s ease, opacity 0.12s ease;
}

.act-t {
	font-size: 13px;
	font-weight: bold;
	color: #245A41;
	font-family: HYSansBold;
}

.act-note {
	font-size: 9px;
	line-height: 1.35;
	color: #9AA394;
	margin-top: 5px;
	text-align: center;
	font-family: HYSans;
}

.pk-card {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 22px;
	margin: 12px 16px 0 16px;
	padding: 16px;
	box-shadow: 0px 4px 14px rgba(36, 90, 65, 0.05);
}

.pk-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.pk-title {
	font-size: 13px;
	font-weight: bold;
	color: #245A41;
	font-family: HYSansBold;
}

.pk-btn {
	display: flex;
	flex-direction: row;
	height: 24px;
	border-radius: 12px;
	background-color: #E9F2E4;
	padding-left: 11px;
	padding-right: 11px;
	align-items: center;
	justify-content: center;
}

.pk-btn-t {
	font-size: 10px;
	font-weight: bold;
	color: #3E7D5C;
	font-family: HYSansBold;
}

.pk-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 12px;
}

.pk-name {
	width: 32px;
	font-size: 10px;
	color: #9AA394;
	font-family: HYSans;
}

.pk-track {
	flex: 1;
	height: 9px;
	border-radius: 5px;
	background-color: #F0F4EA;
	overflow: hidden;
}

.pk-in-me {
	height: 9px;
	border-radius: 5px;
	background-color: #3E7D5C;
}

.pk-in-rival {
	height: 9px;
	border-radius: 5px;
	background-color: #C9DCCB;
}

.pk-score {
	width: 38px;
	font-size: 10px;
	color: #5C6B60;
	text-align: right;
	font-family: HYSans;
}

.tl-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin: 18px 22px 9px 22px;
}

.sec-title {
	font-size: 13px;
	font-weight: bold;
	color: #245A41;
	font-family: HYSansBold;
}

.tl-add-t {
	font-size: 10px;
	color: #3E7D5C;
	font-family: HYSans;
}

.tl-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	margin: 0 16px 0 16px;
}

.tl-card {
	display: flex;
	flex-direction: column;
	width: 31%;
	background-color: #F3F9EF;
	border-radius: 16px;
	padding-top: 12px;
	padding-bottom: 12px;
	align-items: center;
}

.tl-img {
	width: 56px;
	height: 56px;
}

.tl-label {
	font-size: 9px;
	color: #5C6B60;
	margin-top: 8px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.bottom-pad {
	height: 20px;
}

.mask {
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(26, 36, 30, 0.40);
	justify-content: flex-end;
	z-index: 100;
}

.mask-hit {
	flex: 1;
}

.sheet {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 26px;
	padding: 20px 18px calc(24px + env(safe-area-inset-bottom)) 18px;
}

.sheet-title {
	font-size: 17px;
	font-weight: bold;
	color: #1F2B24;
	font-family: HYSansBold;
}

.sheet-sub {
	font-size: 11px;
	color: #9AA394;
	margin-top: 6px;
	font-family: HYSans;
}

.hint-box {
	display: flex;
	flex-direction: column;
	background-color: #F2F7EC;
	border-radius: 14px;
	padding: 12px;
	margin-top: 12px;
}

.hint-t {
	font-size: 12px;
	color: #5C6B60;
	line-height: 19px;
	font-family: HYSans;
}

.sheet-btn {
	display: flex;
	flex-direction: column;
	height: 46px;
	border-radius: 23px;
	align-items: center;
	justify-content: center;
	margin-top: 12px;
	transition: transform 0.12s ease, opacity 0.12s ease;
}

.sheet-btn-main {
	background: linear-gradient(135deg, #4A8A66, #3E7D5C);
	box-shadow: 0 8px 18px rgba(62, 125, 92, 0.28);
}

.sheet-btn-soft {
	background-color: #E9F2E4;
}

.sheet-btn-t {
	font-size: 14px;
	font-weight: bold;
	font-family: HYSansBold;
}

.sheet-btn-t-white {
	color: #FFFFFF;
}

.sheet-btn-t-deep {
	color: #245A41;
}

.pk-compare {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 16px;
}

.pkc-box {
	display: flex;
	flex-direction: column;
	flex: 1;
	background-color: #F2F7EC;
	border-radius: 16px;
	padding: 14px;
	align-items: center;
}

.pkc-name {
	font-size: 11px;
	color: #9AA394;
	font-family: HYSans;
}

.pkc-score {
	font-size: 24px;
	font-weight: bold;
	color: #245A41;
	margin-top: 4px;
	font-family: HYSansBold;
}

.pkc-vs {
	font-size: 12px;
	font-weight: bold;
	color: #B4BCAF;
	margin-left: 10px;
	margin-right: 10px;
	font-family: HYSansBold;
}

.loading-box {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 30px 0 24px 0;
}

.loading-t {
	font-size: 15px;
	font-weight: bold;
	color: #245A41;
	font-family: HYSansBold;
}

.loading-s {
	font-size: 11px;
	color: #9AA394;
	margin-top: 8px;
	font-family: HYSans;
}

.ticket-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.lv-badge {
	display: flex;
	flex-direction: row;
	height: 26px;
	border-radius: 13px;
	background-color: #FBEDEA;
	padding-left: 12px;
	padding-right: 12px;
	align-items: center;
	justify-content: center;
}

.lv-badge-t {
	font-size: 12px;
	font-weight: bold;
	color: #B4553F;
	font-family: HYSansBold;
}

.ticket-no {
	font-size: 11px;
	color: #9AA394;
	font-family: HYSans;
}


/* ===== 页面 3 新增模块样式（任务 / 榜单 / 工单 / 养护核验） ===== */

.stage {
	position: relative;
}

.act-btn-off {
	background-color: #F1F4EC;
}

.act-t-off {
	color: #B4BCAF;
}

.gain-pill {
	position: absolute;
	right: 58px;
	top: 22px;
	height: 24px;
	border-radius: 12px;
	background-color: #E9F2E4;
	padding-left: 10px;
	padding-right: 10px;
	display: flex;
	align-items: center;
	justify-content: center;
	animation: gainFloat 0.9s ease-out forwards;
}

.gain-t {
	font-size: 11px;
	font-weight: bold;
	color: #245A41;
}

@keyframes gainFloat {
	0% { transform: translateY(0); opacity: 1; }
	100% { transform: translateY(-12px); opacity: 0; }
}

.task-card {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 22px;
	margin: 12px 16px 0 16px;
	padding: 14px 16px 6px 16px;
	box-shadow: 0 1px 2px rgba(31, 43, 36, 0.04), 0 8px 24px rgba(36, 90, 65, 0.08);
	animation: riseIn 260ms cubic-bezier(0.22, 0.9, 0.35, 1) 70ms 1 backwards;
}

.sec-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.sec-title {
	font-size: 14px;
	font-weight: bold;
	color: #245A41;
}

.sec-extra {
	font-size: 10px;
	color: #9AA394;
	letter-spacing: 0.4px;
}

.trow {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 11px 6px;
	border-radius: 12px;
}

.trow-done {
	background-color: #FBFCF8;
}

.tdot {
	width: 8px;
	height: 8px;
	border-radius: 4px;
	background-color: #6BB98A;
	margin-right: 10px;
}

.tdot-done {
	background-color: #C9DCCB;
}

.tmain {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.ttitle {
	font-size: 12px;
	font-weight: bold;
	color: #1F2B24;
}

.ttitle-done {
	color: #8D9A8F;
}

.tclaim {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	min-width: 62px;
	height: 26px;
	border-radius: 13px;
	margin-left: 8px;
	padding-left: 10px;
	padding-right: 10px;
	background-color: #F3F9EF;
}

.tclaim-t {
	font-size: 11px;
	font-weight: bold;
	font-family: HYSansBold;
}

.tclaim-on {
	background: linear-gradient(135deg, #E8B04B, #D99C2B);
	box-shadow: 0 4px 10px rgba(217, 156, 43, 0.30);
	animation: claimBreath 2.2s ease-in-out infinite;
}

.tclaim-on .tclaim-t {
	color: #FFFFFF;
}

.tclaim-off {
	background-color: #EDF3E7;
}

.tclaim-off .tclaim-t {
	color: #9AA394;
}

.tclaim-wait .tclaim-t {
	color: #B4BCAF;
}

.rank-card {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 22px;
	margin: 12px 16px 0 16px;
	padding: 14px 16px 8px 16px;
	box-shadow: 0 1px 2px rgba(31, 43, 36, 0.04), 0 8px 24px rgba(36, 90, 65, 0.08);
}

.rrow {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 40px;
	border-radius: 12px;
	padding-left: 6px;
	padding-right: 6px;
}

.rrow-mine {
	background-color: #F3F9EF;
}

.rno {
	width: 20px;
	height: 20px;
	border-radius: 10px;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 8px;
}

.rno-gold { background: linear-gradient(135deg, #F2CE8B, #D99C2B); }
.rno-silver { background-color: #DDE3DA; }
.rno-bronze { background-color: #EBD3C4; }
.rno-plain { background-color: #EEF2E9; }

.rno-t {
	font-size: 10px;
	font-weight: bold;
	color: #5C6B60;
}

.rmain {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.rname {
	font-size: 11px;
	font-weight: bold;
	color: #1F2B24;
}

.rsub {
	font-size: 9px;
	color: #9AA394;
	margin-top: 2px;
}

.rlv {
	height: 18px;
	border-radius: 9px;
	background-color: #E9F2E4;
	padding-left: 7px;
	padding-right: 7px;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 8px;
}

.rlv-t {
	font-size: 9px;
	font-weight: bold;
	color: #3E7D5C;
}

.rscore {
	width: 34px;
	font-size: 10px;
	color: #5C6B60;
	text-align: right;
}

.tl-left {
	display: flex;
	flex-direction: column;
}

.tl-hint {
	font-size: 9px;
	color: #9AA394;
	margin-top: 4px;
	letter-spacing: 0.3px;
}

.tl-acts {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.tl-add-t {
	margin-left: 10px;
}

.tl-empty {
	margin: 0 16px;
	height: 72px;
	border-radius: 16px;
	background-color: #F3F9EF;
	display: flex;
	align-items: center;
	justify-content: center;
}

.tl-empty-t {
	font-size: 10px;
	color: #9AA394;
}

.ticket-card {
	display: flex;
	flex-direction: column;
	background-color: #FFF6F2;
	border-radius: 18px;
	margin: 14px 16px 0 16px;
	padding: 14px 14px 6px 14px;
}

.ht-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 9px 0;
}

.ht-badge {
	height: 20px;
	border-radius: 10px;
	background-color: #FBE4DC;
	padding-left: 8px;
	padding-right: 8px;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 9px;
}

.ht-badge-done {
	background-color: #E9F2E4;
}

.ht-badge-t {
	font-size: 9px;
	font-weight: bold;
	color: #B4553F;
}

.ht-badge-t-done {
	color: #3E7D5C;
}

.ht-main {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.ht-no {
	font-size: 11px;
	font-weight: bold;
	color: #1F2B24;
}

.ht-sub {
	font-size: 9px;
	color: #C08A76;
	margin-top: 3px;
}

.ht-act {
	font-size: 9px;
	color: #B4553F;
}

.hz-preview {
	width: 100%;
	height: 150px;
	border-radius: 14px;
	margin-top: 12px;
}

.all-scroll {
	height: 300px;
	margin-top: 12px;
}

.al-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 8px 0;
	border-bottom: 1px solid #F2F5EE;
}

.al-img {
	width: 52px;
	height: 52px;
	border-radius: 12px;
}

.al-main {
	display: flex;
	flex-direction: column;
	flex: 1;
	margin-left: 12px;
}

.al-title {
	font-size: 11px;
	font-weight: bold;
	color: #1F2B24;
}

.al-desc {
	font-size: 9px;
	color: #9AA394;
	margin-top: 4px;
}

/* ---------- 多树切换条 ---------- */

.mt-bar {
	display: flex;
	flex-direction: row;
	white-space: nowrap;
	margin: 6px 16px 0 16px;
}

.mt-chip {
	display: inline-flex;
	flex-direction: row;
	align-items: center;
	height: 30px;
	border-radius: 15px;
	background-color: #F1F0E9;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 8px;
}

.mt-chip-on {
	background-color: #3E7D5C;
}

.mt-chip-n {
	font-size: 12px;
	color: #3F3D36;
	max-width: 120px;
	overflow: hidden;
	text-overflow: ellipsis;
}

.mt-chip-l {
	font-size: 11px;
	color: #7A7768;
	margin-left: 6px;
}

.mt-chip-l-on {
	color: rgba(255, 255, 255, 0.86);
}
