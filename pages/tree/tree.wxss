.page {
	display: flex;
	flex-direction: column;
	height: 100vh;
	position: relative;
	background-color: #FFFCF6;
	font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "PingFang SC", "MiSans", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
}

.body {
	flex: 1;
	height: 0;
}

.icon-btn {
	display: flex;
	flex-direction: column;
	width: 36px;
	height: 36px;
	border-radius: 18px;
	background-color: #EAF4E6;
	align-items: center;
	justify-content: center;
}

.icon-18 {
	width: 17px;
	height: 17px;
}

.main-card {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 22px;
	margin: 6px 16px 0 16px;
	padding: 16px;
	box-shadow: 0px 4px 14px rgba(46, 107, 79, 0.05);
}

.mc-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.mc-left {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.mc-name {
	font-size: 14px;
	font-weight: bold;
	color: #22302A;
	font-family: HYSansBold;
}

.mc-meta {
	font-size: 10px;
	color: #9AA394;
	margin-top: 5px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.lv-pill {
	display: flex;
	flex-direction: row;
	height: 24px;
	border-radius: 12px;
	background-color: #EAF4E6;
	padding-left: 10px;
	padding-right: 10px;
	align-items: center;
	justify-content: center;
}

.lv-t {
	font-size: 10px;
	font-weight: bold;
	color: #4E8A6B;
	font-family: HYSansBold;
}

.stage {
	display: flex;
	flex-direction: column;
	height: 190px;
	align-items: center;
	justify-content: center;
	margin-top: 4px;
	position: relative;
}

.stage-img {
	width: 168px;
	height: 168px;
}

.weather-pill {
	display: flex;
	flex-direction: row;
	position: absolute;
	right: 0;
	top: 34px;
	height: 26px;
	border-radius: 13px;
	background-color: #FFFFFF;
	padding-left: 11px;
	padding-right: 11px;
	align-items: center;
	justify-content: center;
	box-shadow: 0px 2px 8px rgba(46, 107, 79, 0.10);
}

.weather-t {
	font-size: 10px;
	color: #5C6B60;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.growth-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 2px;
}

.growth-lb {
	font-size: 11px;
	font-weight: bold;
	color: #22302A;
	font-family: HYSansBold;
}

.growth-hint {
	font-size: 10px;
	color: #9AA394;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.gbar {
	height: 10px;
	background-color: #EDF3E7;
	border-radius: 5px;
	margin-top: 9px;
	overflow: hidden;
}

.gbar-in {
	height: 10px;
	background-color: #6BB98A;
	border-radius: 5px;
}

.coin-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 14px;
}

.coin-hint {
	font-size: 10px;
	color: #9AA394;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.act-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	margin-top: 14px;
}

.act-btn {
	display: flex;
	flex-direction: column;
	width: 48%;
	height: 46px;
	border-radius: 23px;
	background-color: #EAF4E6;
	align-items: center;
	justify-content: center;
}

.act-t {
	font-size: 13px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

.pk-card {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 22px;
	margin: 12px 16px 0 16px;
	padding: 16px;
	box-shadow: 0px 4px 14px rgba(46, 107, 79, 0.05);
}

.pk-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.pk-title {
	font-size: 13px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

.pk-btn {
	display: flex;
	flex-direction: row;
	height: 24px;
	border-radius: 12px;
	background-color: #EAF4E6;
	padding-left: 11px;
	padding-right: 11px;
	align-items: center;
	justify-content: center;
}

.pk-btn-t {
	font-size: 10px;
	font-weight: bold;
	color: #4E8A6B;
	font-family: HYSansBold;
}

.pk-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 12px;
}

.pk-name {
	width: 32px;
	font-size: 10px;
	color: #9AA394;
	font-family: HYSans;
}

.pk-track {
	flex: 1;
	height: 9px;
	border-radius: 5px;
	background-color: #F0F4EA;
	overflow: hidden;
}

.pk-in-me {
	height: 9px;
	border-radius: 5px;
	background-color: #4E8A6B;
}

.pk-in-rival {
	height: 9px;
	border-radius: 5px;
	background-color: #C9DCCB;
}

.pk-score {
	width: 38px;
	font-size: 10px;
	color: #5C6B60;
	text-align: right;
	font-family: HYSans;
}

.tl-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin: 18px 22px 9px 22px;
}

.sec-title {
	font-size: 13px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

.tl-add-t {
	font-size: 10px;
	color: #4E8A6B;
	font-family: HYSans;
}

.tl-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	margin: 0 16px 0 16px;
}

.tl-card {
	display: flex;
	flex-direction: column;
	width: 31%;
	background-color: #F3F9EF;
	border-radius: 16px;
	padding-top: 12px;
	padding-bottom: 12px;
	align-items: center;
}

.tl-img {
	width: 56px;
	height: 56px;
}

.tl-label {
	font-size: 9px;
	color: #5C6B60;
	margin-top: 8px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.hazard-card {
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: #FFF6F2;
	border-radius: 18px;
	margin: 14px 16px 0 16px;
	padding: 12px;
}

.hz-ico-box {
	display: flex;
	flex-direction: column;
	width: 34px;
	height: 34px;
	border-radius: 17px;
	background-color: #FBE4DC;
	align-items: center;
	justify-content: center;
}

.hz-ico {
	width: 17px;
	height: 17px;
}

.hz-left {
	display: flex;
	flex-direction: column;
	flex: 1;
	margin-left: 10px;
}

.hz-title {
	font-size: 12px;
	font-weight: bold;
	color: #B4553F;
	font-family: HYSansBold;
}

.hz-sub {
	font-size: 9px;
	color: #C08A76;
	margin-top: 4px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.hz-btn {
	display: flex;
	flex-direction: row;
	height: 30px;
	border-radius: 15px;
	background-color: #E07A5F;
	padding-left: 13px;
	padding-right: 13px;
	align-items: center;
	justify-content: center;
}

.hz-btn-t {
	font-size: 11px;
	font-weight: bold;
	color: #FFFFFF;
	font-family: HYSansBold;
}

.bottom-pad {
	height: 20px;
}

.mask {
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(30, 40, 33, 0.32);
	justify-content: flex-end;
	z-index: 100;
}

.mask-hit {
	flex: 1;
}

.sheet {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 26px;
	padding: 20px 18px 24px 18px;
}

.sheet-title {
	font-size: 17px;
	font-weight: bold;
	color: #22302A;
	font-family: HYSansBold;
}

.sheet-sub {
	font-size: 11px;
	color: #9AA394;
	margin-top: 6px;
	font-family: HYSans;
}

.hint-box {
	display: flex;
	flex-direction: column;
	background-color: #F6FAF2;
	border-radius: 14px;
	padding: 12px;
	margin-top: 12px;
}

.hint-t {
	font-size: 12px;
	color: #5C6B60;
	line-height: 19px;
	font-family: HYSans;
}

.sheet-btn {
	display: flex;
	flex-direction: column;
	height: 48px;
	border-radius: 24px;
	align-items: center;
	justify-content: center;
	margin-top: 12px;
}

.sheet-btn-main {
	background-color: #4E8A6B;
}

.sheet-btn-soft {
	background-color: #EAF4E6;
}

.sheet-btn-t {
	font-size: 14px;
	font-weight: bold;
	font-family: HYSansBold;
}

.sheet-btn-t-white {
	color: #FFFFFF;
}

.sheet-btn-t-deep {
	color: #2E6B4F;
}

.pk-compare {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 16px;
}

.pkc-box {
	display: flex;
	flex-direction: column;
	flex: 1;
	background-color: #F6FAF2;
	border-radius: 16px;
	padding: 14px;
	align-items: center;
}

.pkc-name {
	font-size: 11px;
	color: #9AA394;
	font-family: HYSans;
}

.pkc-score {
	font-size: 24px;
	font-weight: bold;
	color: #2E6B4F;
	margin-top: 4px;
	font-family: HYSansBold;
}

.pkc-vs {
	font-size: 12px;
	font-weight: bold;
	color: #B4BCAF;
	margin-left: 10px;
	margin-right: 10px;
	font-family: HYSansBold;
}

.loading-box {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 30px 0 24px 0;
}

.loading-t {
	font-size: 15px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

.loading-s {
	font-size: 11px;
	color: #9AA394;
	margin-top: 8px;
	font-family: HYSans;
}

.ticket-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.lv-badge {
	display: flex;
	flex-direction: row;
	height: 26px;
	border-radius: 13px;
	background-color: #FBEDEA;
	padding-left: 12px;
	padding-right: 12px;
	align-items: center;
	justify-content: center;
}

.lv-badge-t {
	font-size: 12px;
	font-weight: bold;
	color: #B4553F;
	font-family: HYSansBold;
}

.ticket-no {
	font-size: 11px;
	color: #9AA394;
	font-family: HYSans;
}


/* ===== 页面 3 新增模块样式（任务 / 榜单 / 工单 / 养护核验） ===== */

.stage {
	position: relative;
}

.act-btn-off {
	background-color: #F1F4EC;
}

.act-t-off {
	color: #B4BCAF;
}

.care-tip-row {
	display: flex;
	align-items: center;
	justify-content: center;
	margin-top: 10px;
}

.care-tip {
	font-size: 9px;
	color: #9AA394;
	letter-spacing: 0.3px;
	text-align: center;
}

.gain-pill {
	position: absolute;
	right: 58px;
	top: 22px;
	height: 24px;
	border-radius: 12px;
	background-color: #EAF4E6;
	padding-left: 10px;
	padding-right: 10px;
	display: flex;
	align-items: center;
	justify-content: center;
	animation: gainFloat 0.9s ease-out forwards;
}

.gain-t {
	font-size: 11px;
	font-weight: bold;
	color: #2E6B4F;
}

@keyframes gainFloat {
	0% { transform: translateY(0); opacity: 1; }
	100% { transform: translateY(-12px); opacity: 0; }
}

.task-card {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 22px;
	margin: 12px 16px 0 16px;
	padding: 14px 16px 6px 16px;
	box-shadow: 0px 4px 14px rgba(46, 107, 79, 0.05);
}

.sec-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.sec-title {
	font-size: 13px;
	font-weight: bold;
	color: #2E6B4F;
}

.sec-extra {
	font-size: 10px;
	color: #9AA394;
	letter-spacing: 0.4px;
}

.streak-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
