<template>
	<view class="page">
		<nav-bar title="我的林地" :subtitle="'在养 1 棵 · 成长值 ' + tree.growthScore.toFixed(0)">
			<view class="icon-btn" @click="onBell">
				<image class="icon-18" src="/static/ui/bell.png"></image>
			</view>
		</nav-bar>

		<scroll-view class="body" direction="vertical">
			<view class="main-card">
				<view class="mc-head">
					<view class="mc-left">
						<text class="mc-name">{{ tree.name }}</text>
						<text class="mc-meta">{{ tree.species }} · 树龄 {{ tree.age }}</text>
					</view>
					<view class="lv-pill">
						<text class="lv-t">Lv.{{ tree.level.toFixed(0) }} 护林人</text>
					</view>
				</view>

				<view class="stage">
					<image class="stage-img" src="/static/illus/palm.png"></image>
					<view class="weather-pill">
						<text class="weather-t">{{ weatherLine }}</text>
					</view>
				</view>

				<view class="growth-row">
					<text class="growth-lb">成长值 {{ tree.growthScore.toFixed(0) }} / 1000</text>
					<text class="growth-hint">{{ nextNeed }}</text>
				</view>
				<view class="gbar">
					<view class="gbar-in" :style="growthBarStyle"></view>
				</view>

				<view class="act-row">
					<view class="act-btn" @click="onWater">
						<text class="act-t">浇水</text>
					</view>
					<view class="act-btn" @click="onFertilize">
						<text class="act-t">施肥</text>
					</view>
				</view>
			</view>

			<view class="pk-card">
				<view class="pk-head">
					<text class="pk-title">成长 PK 擂台</text>
					<view class="pk-btn" @click="openPk">
						<text class="pk-btn-t">发起 PK</text>
					</view>
				</view>
				<view class="pk-row">
					<text class="pk-name">我</text>
					<view class="pk-track">
						<view class="pk-in-me" :style="pkMeStyle"></view>
					</view>
					<text class="pk-score">{{ tree.growthScore.toFixed(0) }}</text>
				</view>
				<view class="pk-row">
					<text class="pk-name">同龄</text>
					<view class="pk-track">
						<view class="pk-in-rival" :style="pkRivalStyle"></view>
					</view>
					<text class="pk-score">{{ rivalScore.toFixed(0) }}</text>
				</view>
			</view>

			<view class="tl-head">
				<text class="sec-title">线下生长时光轴</text>
				<text class="tl-add-t" @click="openUpload">＋ 上传实拍</text>
			</view>

			<view class="tl-row">
				<view v-for="(log, i) in growthLogs" :key="log.logId" class="tl-card">
					<image class="tl-img" :src="log.imageUrl"></image>
					<text class="tl-label">{{ stageLabel(log, i) }}</text>
				</view>
			</view>

			<view class="hazard-card">
				<view class="hz-ico-box">
					<image class="hz-ico" src="/static/ui/camera.png"></image>
				</view>
				<view class="hz-left">
					<text class="hz-title">树有异常？</text>
					<text class="hz-sub">拍一张，AI 判断风险并通知后勤</text>
				</view>
				<view class="hz-btn" @click="openHazard">
					<text class="hz-btn-t">拍照上报</text>
				</view>
			</view>

			<view class="bottom-pad"></view>
		</scroll-view>

		<app-tabbar active="tree"></app-tabbar>

		<view class="mask" v-if="sheetMode != ''">
			<view class="mask-hit" @click="closeSheet"></view>
			<view class="sheet">
				<view v-if="sheetMode == 'pk'">
					<text class="sheet-title">树木成长 PK</text>
					<text class="sheet-sub">与同龄树「中山楼后 · 香樟」比一比战力</text>
					<view class="pk-compare">
						<view class="pkc-box">
							<text class="pkc-name">我的树</text>
							<text class="pkc-score">{{ tree.growthScore.toFixed(0) }}</text>
						</view>
						<text class="pkc-vs">VS</text>
						<view class="pkc-box">
							<text class="pkc-name">同龄树</text>
							<text class="pkc-score">{{ rivalScore.toFixed(0) }}</text>
						</view>
					</view>
					<view class="hint-box">
						<text class="hint-t">{{ pkResultText }}</text>
					</view>
					<view class="sheet-btn sheet-btn-main" @click="doPk">
						<text class="sheet-btn-t sheet-btn-t-white">发起挑战</text>
					</view>
				</view>

				<view v-if="sheetMode == 'hazard'">
					<text class="sheet-title">拍一拍：隐患 / 虫害上报</text>
					<text class="sheet-sub">AI 会识别风险等级并生成后勤工单</text>
					<view class="hint-box">
						<text class="hint-t">重点排查：大王椰枯叶悬垂、台风断枝、树干白蚁或红火蚁。上报成功可获得 100 护林积分。</text>
					</view>
					<view class="sheet-btn sheet-btn-main" @click="useSampleHazard">
						<text class="sheet-btn-t sheet-btn-t-white">使用示例现场照片（演示）</text>
					</view>
					<view class="sheet-btn sheet-btn-soft" @click="pickHazardPhoto">
						<text class="sheet-btn-t sheet-btn-t-deep">拍照 / 从相册选</text>
					</view>
				</view>

				<view v-if="sheetMode == 'hazardLoading'" class="loading-box">
					<text class="loading-t">AI 树木安全巡检中{{ dots }}</text>
					<text class="loading-s">正在识别病虫害类型与高空坠叶风险</text>
				</view>

				<view v-if="sheetMode == 'hazardResult'">
					<view class="ticket-head">
						<view class="lv-badge">
							<text class="lv-badge-t">{{ hazard.level }}预警</text>
						</view>
						<text class="ticket-no">工单号 {{ hazard.ticket }}</text>
					</view>
					<view class="hint-box">
						<text class="hint-t">{{ hazard.analysis }}</text>
					</view>
					<view class="hint-box">
						<text class="hint-t">建议处理：{{ hazard.advice }}</text>
					</view>
					<view class="sheet-btn sheet-btn-main" @click="submitHazard">
						<text class="sheet-btn-t sheet-btn-t-white">提交后勤工单 · 领 {{ hazard.reward.toFixed(0) }} 积分</text>
					</view>
				</view>

				<view v-if="sheetMode == 'upload'">
					<text class="sheet-title">上传线下生长实拍</text>
					<text class="sheet-sub">每张实拍 +20 积分，都会记入树的生长历程</text>
					<view class="hint-box">
						<text class="hint-t">建议每两周拍一张，完整记录它从春芽到枝繁叶茂的全过程。</text>
					</view>
					<view class="sheet-btn sheet-btn-main" @click="useSampleUpload">
						<text class="sheet-btn-t sheet-btn-t-white">使用示例照片（演示）</text>
					</view>
					<view class="sheet-btn sheet-btn-soft" @click="pickGrowthPhoto">
						<text class="sheet-btn-t sheet-btn-t-deep">拍照 / 从相册选</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
	import NavBar from '@/components/nav-bar.uvue'
	import AppTabbar from '@/components/app-tabbar.uvue'
	import { Tree, TreeLog, AiHazardResult } from '@/common/model.uts'
	import { store, myTree, water, fertilize, reportHazard, addGrowthLog } from '@/common/store.uts'
	import { aiAnalyzeHazard } from '@/common/ai.uts'
	import { toast } from '@/common/util.uts'

	const tree = computed(() : Tree => myTree())
	const rivalScore : number = 720

	const sheetMode = ref<string>('')
	const dots = ref<string>('')
	let dotTimer : number = 0

	const weatherLine = computed(() : string => {
		return '今天风大，我的叶子有点痒～'
	})

	const nextNeed = computed(() : string => {
		const rest = 1000 - tree.value.growthScore
		return rest > 0 ? ('再涨 ' + rest.toFixed(0) + ' 升级') : '已满级'
	})

	const growthBarStyle = computed(() : string => {
		let p = tree.value.growthScore / 1000 * 100
		if (p > 100) {
			p = 100
		}
		return 'width:' + p.toFixed(0) + '%'
	})

	const pkMeStyle = computed(() : string => {
		let p = tree.value.growthScore / 1000 * 100
		if (p > 100) {
			p = 100
		}
		return 'width:' + p.toFixed(0) + '%'
	})

	const pkRivalStyle = computed(() : string => {
		let p = rivalScore / 1000 * 100
		if (p > 100) {
			p = 100
		}
		return 'width:' + p.toFixed(0) + '%'
	})

	const pkResultText = computed(() : string => {
		const gap = tree.value.growthScore - rivalScore
		if (gap > 0) {
			return '你的树领先 ' + gap.toFixed(0) + ' 点成长值，胜方可额外获得 50 积分。'
		}
		return '还差 ' + (0 - gap).toFixed(0) + ' 点成长值。多浇水施肥，反超后再来挑战。'
	})

	const growthLogs = computed(() : Array<TreeLog> => {
		const out : Array<TreeLog> = []
		let i = 0
		while (i < store.logs.length) {
			if (store.logs[i].kind == 'growth') {
				out.push(store.logs[i])
			}
			i++
		}
		return out
	})

	const hazard = ref<AiHazardResult>({
		level: '', ticket: '', analysis: '', advice: '', reward: 0
	} as AiHazardResult)

	function stageLabel(log : TreeLog, i : number) : string {
		const stages : Array<string> = ['幼芽', '新叶', '枝繁']
		const stage = i < stages.length ? stages[i] : '生长'
		const mm = log.createdAt.substring(0, 2)
		const m = mm.substring(0, 1) == '0' ? mm.substring(1, 2) : mm
		return m + ' 月 · ' + stage
	}

	function closeSheet() {
		stopDots()
		sheetMode.value = ''
	}

	function startDots() {
		dots.value = ''
		dotTimer = setInterval(() => {
			dots.value = dots.value.length >= 3 ? '' : dots.value + '.'
		}, 300)
	}

	function stopDots() {
		if (dotTimer != 0) {
			clearInterval(dotTimer)
			dotTimer = 0
		}
	}

	function onWater() {
		const err = water()
		if (err != '') {
			toast(err)
			return
		}
		toast('浇水成功，成长值 +20')
	}

	function onFertilize() {
		const err = fertilize()
		if (err != '') {
			toast(err)
			return
		}
		toast('施肥成功，成长值 +50')
	}

	function openPk() {
		sheetMode.value = 'pk'
	}

	function doPk() {
		if (tree.value.growthScore > rivalScore) {
			store.user.availablePoints = store.user.availablePoints + 50
			toast('PK 获胜！+50 积分')
			sheetMode.value = ''
		} else {
			toast('惜败，成长值反超后再来')
		}
	}

	function openHazard() {
		sheetMode.value = 'hazard'
	}

	function useSampleHazard() {
		startHazard()
	}

	function pickHazardPhoto() {
		uni.chooseImage({
			count: 1,
			success: (res) => {
				console.log('隐患照片：', res.tempFilePaths)
				startHazard()
			}
		})
	}

	function startHazard() {
		sheetMode.value = 'hazardLoading'
		startDots()
		aiAnalyzeHazard(tree.value.name, tree.value.species, (r : AiHazardResult) => {
			stopDots()
			hazard.value = r
			sheetMode.value = 'hazardResult'
		})
	}

	function submitHazard() {
		const err = reportHazard(hazard.value, tree.value.hazardText)
		if (err != '') {
			toast(err)
			return
		}
		sheetMode.value = ''
		toast('工单已推送总务处，+' + hazard.value.reward.toFixed(0) + ' 积分')
	}

	function openUpload() {
		sheetMode.value = 'upload'
	}

	function useSampleUpload() {
		addGrowthLog('/static/illus/stage3.png', '今天又长高了一点点')
		sheetMode.value = ''
		toast('已记入成长时光轴，+20 积分')
	}

	function pickGrowthPhoto() {
		uni.chooseImage({
			count: 1,
			success: (res) => {
				console.log('生长实拍：', res.tempFilePaths)
				addGrowthLog('/static/illus/stage3.png', '线下实拍已记录')
				sheetMode.value = ''
				toast('已记入成长时光轴，+20 积分')
			}
		})
	}

	function onBell() {
		toast('1.0 骨架：生长提醒通知，队员 C 可在此接入本地推送')
	}
</script>

