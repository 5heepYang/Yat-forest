<view class="page {{navAnim}}">
	<nav-bar title="我的林地" subtitle="{{navSubtitle}}"></nav-bar>

	<scroll-view class="body" scroll-y>
		<!-- 我认养的多棵树：只有一棵时不显示切换条 -->
		<scroll-view class="mt-bar" scroll-x wx:if="{{myTrees.length > 1}}">
			<view
				class="mt-chip {{item.active ? 'mt-chip-on' : ''}}"
				wx:for="{{myTrees}}"
				wx:key="treeId"
				data-id="{{item.treeId}}"
				bindtap="onSwitchTree"
			>
				<text class="mt-chip-n">{{item.name}}</text>
				<text class="mt-chip-l {{item.active ? 'mt-chip-l-on' : ''}}">Lv.{{item.level}}</text>
			</view>
		</scroll-view>

		<!-- 当前养护的树 -->
		<view class="main-card">
			<view class="mc-head">
				<view class="mc-left">
					<text class="mc-name">{{tree.name}}</text>
					<text class="mc-meta">{{tree.species}} · 树龄 {{tree.age}}</text>
				</view>
				<view class="lv-pill">
					<text class="lv-t">Lv.{{tree.level}} {{levelTitle}}</text>
				</view>
			</view>

			<view class="stage">
				<image class="stage-img" src="{{tree.art}}" mode="aspectFit"></image>
				<view class="weather-pill" bindtap="onSpirit">
					<text class="weather-t">{{spiritLine}}</text>
				</view>
				<view class="gain-pill" wx:if="{{gainShow}}">
					<text class="gain-t">+{{gainText}}</text>
				</view>
			</view>

			<view class="growth-row">
				<text class="growth-lb">成长值 {{tree.growthScore}} / 1000</text>
				<text class="growth-hint">{{nextNeed}}</text>
			</view>
			<view class="gbar">
				<view class="gbar-in" style="{{growthBarStyle}}"></view>
			</view>

			<view class="act-row">
				<view class="act-col">
					<view class="act-btn {{atMax ? 'act-btn-off' : ''}}" hover-class="hv-press" bindtap="onWater">
						<text class="act-t {{atMax ? 'act-t-off' : ''}}">{{atMax ? '已满级' : '浇水'}}</text>
					</view>
					<text class="act-note {{atMax ? 'act-t-off' : ''}}">{{waterNote}}</text>
				</view>
				<view class="act-col">
					<view class="act-btn {{atMax ? 'act-btn-off' : ''}}" hover-class="hv-press" bindtap="onFertilize">
						<text class="act-t {{atMax ? 'act-t-off' : ''}}">{{atMax ? '已满级' : '施肥'}}</text>
					</view>
					<text class="act-note {{atMax ? 'act-t-off' : ''}}">{{fertNote}}</text>
				</view>
				<view class="act-col">
					<view class="act-btn {{photoDone ? 'act-btn-off' : ''}}" hover-class="hv-press" bindtap="onPhotoAct">
						<text class="act-t {{photoDone ? 'act-t-off' : ''}}">生长实拍</text>
					</view>
					<text class="act-note {{photoDone ? 'act-t-off' : ''}}">{{photoNote}}</text>
				</view>
			</view>
		</view>

		<!-- 成长任务 -->
		<view class="task-card">
			<view class="sec-head">
				<text class="sec-title">成长任务</text>
			</view>
			<view class="trow {{item.done ? 'trow-done' : ''}}" wx:for="{{tasks}}" wx:key="kind" bindtap="onTask" data-kind="{{item.kind}}">
				<view class="tdot {{item.done ? 'tdot-done' : ''}}"></view>
				<view class="tmain">
					<text class="ttitle {{item.done ? 'ttitle-done' : ''}}">{{item.title}}</text>
				</view>
				<view
					class="tclaim {{item.claimable ? 'tclaim-on' : (item.claimed ? 'tclaim-off' : 'tclaim-wait')}}" hover-class="hv-press"
					catchtap="onClaim"
					data-kind="{{item.kind}}"
				>
					<text class="tclaim-t">{{item.claimable ? '领取 +' + item.reward + ' 护林币' : (item.claimed ? '已领取' : '待完成')}}</text>
				</view>
			</view>
		</view>

		<!-- 同校树木等级榜 -->
		<view class="rank-card">
			<view class="sec-head">
				<text class="sec-title">同校树木等级榜</text>
				<text class="sec-extra">{{rankText}}</text>
			</view>
			<view class="rrow {{item.mine ? 'rrow-mine' : ''}}" wx:for="{{rankTop}}" wx:key="treeId">
				<view class="{{item.noCls}}">
					<text class="rno-t">{{item.no}}</text>
				</view>
				<view class="rmain">
					<text class="rname">{{item.name}}</text>
					<text class="rsub">{{item.owner}}</text>
				</view>
				<view class="rlv">
					<text class="rlv-t">Lv.{{item.level}}</text>
				</view>
				<text class="rscore">{{item.score}}</text>
			</view>
			<view class="rrow rrow-mine" wx:if="{{myOutOfTop}}">
				<view class="rno rno-plain">
					<text class="rno-t">{{myRankRow.no}}</text>
				</view>
				<view class="rmain">
					<text class="rname">{{myRankRow.name}}</text>
					<text class="rsub">我</text>
				</view>
				<view class="rlv">
					<text class="rlv-t">Lv.{{myRankRow.level}}</text>
				</view>
				<text class="rscore">{{myRankRow.score}}</text>
			</view>
		</view>

		<!-- 线下生长时光轴 -->
		<view class="tl-head">
			<view class="tl-left">
				<text class="sec-title">线下生长时光轴</text>
				<text class="tl-hint">{{photoHint}}</text>
			</view>
			<view class="tl-acts">
				<text class="tl-add-t" wx:if="{{photoCount > 3}}" bindtap="openAllLogs">全部 {{photoCount}}</text>
			</view>
		</view>

		<view class="tl-empty" wx:if="{{photos.length == 0}}">
			<text class="tl-empty-t">还没有线下实拍，拍一张记录它的第一天</text>
		</view>
		<view class="tl-row" wx:else>
			<view class="tl-card" wx:for="{{photos}}" wx:key="logId">
				<image class="tl-img" src="{{item.imageUrl}}" data-i="{{index}}" binderror="onPhotoError"></image>
				<text class="tl-label">{{item.label}}</text>
			</view>
		</view>

		<!-- 我的隐患工单 -->
		<view class="ticket-card" wx:if="{{tickets.length > 0}}">
			<view class="sec-head">
				<text class="sec-title">我的隐患工单</text>
				<text class="sec-extra">共 {{tickets.length}} 张</text>
			</view>
			<view class="ht-row" wx:for="{{tickets}}" wx:key="id">
				<view class="ht-badge {{item.resolved ? 'ht-badge-done' : ''}}">
					<text class="ht-badge-t {{item.resolved ? 'ht-badge-t-done' : ''}}">{{item.level}}</text>
				</view>
				<view class="ht-main">
					<text class="ht-no">{{item.ticket}}</text>
					<text class="ht-sub">{{item.dateText}} · {{item.resolved ? '后勤已处理' : '待后勤处理'}}</text>
				</view>
				<text class="ht-act" wx:if="{{!item.resolved}}" bindtap="resolveTicket" data-id="{{item.id}}">演示·已处理</text>
			</view>
		</view>

		<view class="bottom-pad"></view>
	</scroll-view>

	<view class="tabbar-holder"></view>

	<view class="mask" wx:if="{{sheetMode != ''}}">
		<view class="mask-hit" bindtap="closeSheet"></view>
		<view class="sheet">
			<!-- 隐患上报 -->
			<view wx:if="{{sheetMode == 'hazard'}}">
				<text class="sheet-title">拍一拍：隐患 / 虫害上报</text>
				<text class="sheet-sub">AI 会识别风险等级并生成后勤工单</text>
				<view class="hint-box">
					<text class="hint-t">重点排查：大王椰枯叶悬垂、台风断枝、树干白蚁或红火蚁。上报成功可获得护林积分。</text>
				</view>
				<view class="sheet-btn sheet-btn-main" hover-class="hv-press" bindtap="useSampleHazard">
					<text class="sheet-btn-t sheet-btn-t-white">使用示例现场照片（演示）</text>
				</view>
				<view class="sheet-btn sheet-btn-soft" hover-class="hv-press" bindtap="pickHazardPhoto">
					<text class="sheet-btn-t sheet-btn-t-deep">拍照 / 从相册选</text>
				</view>
			</view>

			<view wx:if="{{sheetMode == 'hazardLoading'}}" class="loading-box">
				<text class="loading-t">AI 树木安全巡检中{{dots}}</text>
				<text class="loading-s">正在识别病虫害类型与高空坠叶风险</text>
			</view>

			<view wx:if="{{sheetMode == 'hazardResult'}}">
				<view class="ticket-head">
					<view class="lv-badge">
						<text class="lv-badge-t">{{hazard.level}}预警</text>
					</view>
					<text class="ticket-no">工单号 {{hazard.ticket}}</text>
				</view>
				<image class="hz-preview" src="{{hazardImage}}" mode="aspectFill" binderror="onHazardImgError"></image>
				<view class="hint-box">
					<text class="hint-t">{{hazard.analysis}}</text>
				</view>
				<view class="hint-box">
					<text class="hint-t">建议处理：{{hazard.advice}}</text>
				</view>
				<view class="sheet-btn sheet-btn-main" hover-class="hv-press" bindtap="submitHazard">
					<text class="sheet-btn-t sheet-btn-t-white">提交后勤工单 · 领 {{hazard.reward}} 积分</text>
				</view>
			</view>

			<!-- 上传实拍 -->
			<view wx:if="{{sheetMode == 'upload'}}">
				<text class="sheet-title">上传线下生长实拍</text>
				<text class="sheet-sub">{{photoPeriodSub}} · 上传后可在成长任务里领取 +50 护林币与 +30 成长</text>
				<view class="hint-box">
					<text class="hint-t">{{photoPeriodSub}}，记录它的生长；系统会核对是不是同一棵树。</text>
				</view>
				<view class="sheet-btn sheet-btn-soft" hover-class="hv-press" bindtap="pickGrowthPhoto">
					<text class="sheet-btn-t sheet-btn-t-deep">拍照 / 从相册选</text>
				</view>
			</view>

			<!-- 全部时光轴 -->
			<view wx:if="{{sheetMode == 'allLogs'}}">
				<text class="sheet-title">生长时光轴 · 共 {{photoCount}} 张</text>
				<text class="sheet-sub">按时间从新到旧排列</text>
				<scroll-view class="all-scroll" scroll-y>
					<view class="al-row" wx:for="{{allPhotos}}" wx:key="logId">
						<image class="al-img" src="{{item.imageUrl}}" mode="aspectFill" data-i="{{index}}" binderror="onAllPhotoError"></image>
						<view class="al-main">
							<text class="al-title">{{item.label}}</text>
							<text class="al-desc">{{item.desc}}</text>
						</view>
					</view>
				</scroll-view>
				<view class="sheet-btn sheet-btn-soft" hover-class="hv-press" bindtap="closeSheet">
					<text class="sheet-btn-t sheet-btn-t-deep">关闭</text>
				</view>
			</view>
		</view>
	</view>
</view>
