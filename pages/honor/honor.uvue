<template>
	<view class="page">
		<scroll-view class="body" direction="vertical">
		<view class="hero">
			<view class="status-pad"></view>
			<text class="hero-sub">南校园 · 护林第 {{ store.user.days.toFixed(0) }} 天</text>
			<text class="hero-name">{{ store.user.nickname }}</text>
			<view class="hero-row">
				<view class="avatar-box">
					<image class="avatar-img" :src="store.user.avatar"></image>
				</view>
				<view class="hero-info">
					<text class="hero-line1">Lv.{{ treeLevel }} 护林人 · 椰林排雷兵</text>
					<text class="hero-line2">已点亮 {{ unlockedCount }} / {{ store.badges.length }} 枚勋章</text>
				</view>
			</view>
		</view>

			<view class="stats">
				<view class="stat-cell">
					<text class="stat-num">{{ fmt(store.user.availablePoints) }}</text>
					<text class="stat-lb">可用碳积分</text>
				</view>
				<view class="stat-cell">
					<text class="stat-num">{{ fmt(store.user.totalGrowthScore) }}</text>
					<text class="stat-lb">累计成长值</text>
				</view>
				<view class="stat-cell">
					<view class="stat-num-row">
						<text class="stat-num">{{ adoptedCount }}</text>
						<text class="stat-unit">棵</text>
					</view>
					<text class="stat-lb">我的树</text>
				</view>
			</view>

			<view class="sec-row">
				<text class="sec-title">勋章墙 · 已点亮 {{ unlockedCount }} / {{ store.badges.length }}</text>
			</view>

			<view class="badge-row">
				<view v-for="b in topBadges" :key="b.badgeId" class="badge-cell">
					<view :class="b.unlocked ? badgeBg(b) : 'badge-circle badge-off'">
						<image class="badge-ico" :src="b.icon"></image>
					</view>
					<text :class="b.unlocked ? 'badge-name badge-name-on' : 'badge-name'">{{ b.name }}</text>
				</view>
			</view>

			<view class="sec-row">
				<text class="sec-title">森林补给站 · 用积分换周边</text>
			</view>

			<view class="mytree-card" @click="goTree">
				<view class="mt-thumb">
					<image class="mt-img" src="/static/illus/palm.png"></image>
				</view>
				<view class="mt-info">
					<text class="mt-name">我的树 · {{ treeName }}</text>
					<text class="mt-sub">Lv.{{ treeLevel }} · 成长值 {{ treeGrowth }} / 1000</text>
				</view>
				<view class="go-pill">
					<text class="go-pill-t">去看看</text>
				</view>
			</view>

			<view class="list-card">
				<view class="list-row">
					<text class="list-k">我的认养</text>
					<text class="list-v">{{ adoptText }}</text>
				</view>
				<view class="list-row">
					<text class="list-k">兑换记录</text>
					<text class="list-v">{{ recordText }}</text>
				</view>
			</view>

			<view class="goods-row">
				<view v-for="g in topGoods" :key="g.itemId" class="goods-card" @click="openExchange(g)">
					<view :class="imgBoxClass(g.itemId)">
						<image class="goods-img" :src="g.image"></image>
					</view>
					<text class="goods-name">{{ g.name }}</text>
					<text class="goods-cost">{{ g.costPoints.toFixed(0) }} 积分</text>
				</view>
			</view>

			<view class="bottom-pad"></view>
		</scroll-view>

		<app-tabbar active="me"></app-tabbar>

		<view class="mask" v-if="sheetMode != ''">
			<view class="mask-hit" @click="closeSheet"></view>
			<view class="sheet">
				<view v-if="sheetMode == 'confirm'">
					<text class="sheet-title">{{ currentGoods.name }}</text>
					<text class="sheet-sub">{{ currentGoods.desc }}</text>
					<view class="hint-box">
						<text class="hint-t">将消耗 {{ currentGoods.costPoints.toFixed(0) }} 积分，兑换后生成专属凭证码，到校园绿化服务点出示即可领取。</text>
					</view>
					<view class="sheet-btn sheet-btn-main" @click="doExchange">
						<text class="sheet-btn-t sheet-btn-t-white">确认兑换</text>
					</view>
				</view>

				<view v-if="sheetMode == 'ok'">
					<view class="ok-head">
						<text class="ok-title">兑换成功</text>
						<text class="ok-sub">{{ currentGoods.name }}</text>
					</view>
					<view class="code-box">
						<text class="code-lb">兑换凭证码</text>
						<text class="code-t">{{ codeText }}</text>
					</view>
					<view class="sheet-btn sheet-btn-soft" @click="closeSheet">
						<text class="sheet-btn-t sheet-btn-t-deep">收好了</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
	import AppTabbar from '@/components/app-tabbar.uvue'
	import { Souvenir, Badge } from '@/common/model.uts'
	import { store, myTree, exchange, ExchangeResult } from '@/common/store.uts'
	import { fmt, toast } from '@/common/util.uts'

	const sheetMode = ref<string>('')
	const codeText = ref<string>('')

	function emptyGoods() : Souvenir {
		const g : Souvenir = {
			itemId: '', name: '', costPoints: 0, stock: 0, image: '', desc: ''
		}
		return g
	}

	const currentGoods = ref<Souvenir>(emptyGoods())

	const adoptedCount = computed(() : number => {
		let c = 0
		let i = 0
		while (i < store.trees.length) {
			if (store.trees[i].ownerId == store.user.userId) {
				c++
			}
			i++
		}
		return c
	})

	const unlockedCount = computed(() : number => {
		let c = 0
		let i = 0
		while (i < store.badges.length) {
			if (store.badges[i].unlocked) {
				c++
			}
			i++
		}
		return c
	})

	const topBadges = computed(() : Array<Badge> => {
		const out : Array<Badge> = []
		let i = 0
		while (i < store.badges.length && i < 4) {
			out.push(store.badges[i])
			i++
		}
		return out
	})

	const topGoods = computed(() : Array<Souvenir> => {
		const out : Array<Souvenir> = []
		let i = 0
		while (i < store.goods.length && i < 2) {
			out.push(store.goods[i])
			i++
		}
		return out
	})

	const treeName = computed(() : string => myTree().name)
	const treeGrowth = computed(() : string => myTree().growthScore.toFixed(0))
	const treeLevel = computed(() : string => myTree().level.toFixed(0))

	const adoptText = computed(() : string => {
		const t = myTree()
		if (t.treeId == '') {
			return '暂无'
		}
		return t.species + ' · 08 号'
	})

	const recordText = computed(() : string => {
		if (store.records.length == 0) {
			return '暂无'
		}
		return store.records.length.toFixed(0) + ' 次 · 帆布袋'
	})

	function badgeBg(b : Badge) : string {
		if (b.badgeId == 'b_01') {
			return 'badge-circle badge-gold'
		}
		if (b.badgeId == 'b_02') {
			return 'badge-circle badge-pink'
		}
		return 'badge-circle badge-green'
	}

	function imgBoxClass(itemId : string) : string {
		return itemId == 's_301' ? 'goods-box goods-box-green' : 'goods-box goods-box-cream'
	}

	function openExchange(g : Souvenir) {
		currentGoods.value = g
		sheetMode.value = 'confirm'
	}

	function doExchange() {
		const r : ExchangeResult = exchange(currentGoods.value.itemId)
		if (!r.ok) {
			toast(r.msg)
			return
		}
		codeText.value = r.code
		sheetMode.value = 'ok'
	}

	function closeSheet() {
		sheetMode.value = ''
	}

	function goTree() {
		uni.reLaunch({
			url: '/pages/tree/tree'
		})
	}
</script>

