<view class="page">
	<scroll-view class="body" scroll-y>
		<view class="hero">
			<view class="status-pad" style="height:{{statusBarHeight}}px"></view>

			<view class="back-pill" wx:if="{{guest}}" bindtap="goBack">
				<text class="back-pill-t">{{backText}}</text>
			</view>

			<text class="hero-sub">{{guest ? '南校园 · 认养人主页' : '南校园 · 护林第 ' + days + ' 天'}}</text>
			<text class="hero-name" bindtap="openProfile">{{nickname}}</text>
			<view class="hero-row">
				<view class="avatar-box">
					<image class="avatar-img" src="{{avatar}}"></image>
				</view>
				<view class="hero-info">
					<text class="hero-line1">Lv.{{treeLevel}} 护林人 · 椰林排雷兵</text>
					<text class="hero-line2" wx:if="{{!guest}}">已点亮 {{unlockedCount}} / {{badgeTotal}} 枚勋章</text>
					<text class="hero-line2" wx:else>在养 {{adoptedCount}} 棵树</text>
				</view>
			</view>
		</view>

		<view class="stats" wx:if="{{!guest}}">
			<view class="stat-cell">
				<text class="stat-num">{{pointsText}}</text>
				<text class="stat-lb">可用碳积分</text>
			</view>
			<view class="stat-cell">
				<text class="stat-num">{{growthText}}</text>
				<text class="stat-lb">累计成长值</text>
			</view>
			<view class="stat-cell">
				<view class="stat-num-row">
					<text class="stat-num">{{adoptedCount}}</text>
					<text class="stat-unit">棵</text>
				</view>
				<text class="stat-lb">我的树</text>
			</view>
		</view>

		<!-- 访客只能看到从公有数据（trees）推算出来的东西 -->
		<view class="stats" wx:else>
			<view class="stat-cell">
				<view class="stat-num-row">
					<text class="stat-num">{{adoptedCount}}</text>
					<text class="stat-unit">棵</text>
				</view>
				<text class="stat-lb">认养的树</text>
			</view>
			<view class="stat-cell">
				<view class="stat-num-row">
					<text class="stat-num">Lv.{{treeLevel}}</text>
				</view>
				<text class="stat-lb">最高等级</text>
			</view>
			<view class="stat-cell">
				<text class="stat-num">{{growthText}}</text>
				<text class="stat-lb">总成长值</text>
			</view>
		</view>

		<view class="sec-row" wx:if="{{!guest}}">
			<text class="sec-title">勋章墙 · 已点亮 {{unlockedCount}} / {{badgeTotal}}</text>
		</view>

		<view class="badge-row" wx:if="{{!guest}}">
			<view class="badge-cell" wx:for="{{topBadges}}" wx:key="badgeId">
				<view class="{{item.cls}}">
					<image class="badge-ico" src="{{item.icon}}"></image>
				</view>
				<text class="{{item.unlocked ? 'badge-name badge-name-on' : 'badge-name'}}">{{item.name}}</text>
			</view>
		</view>

		<view class="sec-row sec-row-between">
			<text class="sec-title">{{guest ? 'TA 的树' : '我的树'}} · {{adoptedCount}} 棵</text>
			<text class="sec-more" wx:if="{{myTrees.length > 0 && !guest}}" bindtap="goTree">去林地养护 ›</text>
		</view>

		<scroll-view class="mytree-bar" scroll-x wx:if="{{myTrees.length > 0}}">
			<view
				class="mytree-card2 {{item.active ? 'mytree-card2-on' : ''}}"
				wx:for="{{myTrees}}"
				wx:key="treeId"
				data-id="{{item.treeId}}"
				bindtap="openTree"
			>
				<view class="mt-thumb">
					<image class="mt-img" src="{{item.image}}"></image>
				</view>
				<view class="mt-info">
					<text class="mt-name">{{item.name}}</text>
					<text class="mt-sub">Lv.{{item.level}} · 成长值 {{item.growth}}</text>
				</view>
				<view class="go-pill">
					<text class="go-pill-t">{{item.active ? '养护中' : '去养护'}}</text>
				</view>
			</view>
		</scroll-view>

		<view class="mytree-empty" wx:elif="{{!guest}}" bindtap="goTree">
			<text class="mytree-empty-t">还没有认养的树 · 去地图认养一棵</text>
		</view>

		<view class="mytree-empty" wx:else>
			<text class="mytree-empty-t">TA 还没有认养树木</text>
		</view>

		<view class="list-card" wx:if="{{!guest}}">
			<view class="list-row">
				<text class="list-k">我的认养</text>
				<text class="list-v">{{adoptText}}</text>
			</view>
			<view class="list-row">
				<text class="list-k">兑换记录</text>
				<text class="list-v">{{recordText}}</text>
			</view>
		</view>

		<view class="sec-row" wx:if="{{!guest}}">
			<text class="sec-title">森林补给站 · 用护林币换周边</text>
		</view>

		<view class="goods-row" wx:if="{{!guest}}">
			<view
				class="goods-card"
				wx:for="{{topGoods}}"
				wx:key="itemId"
				data-id="{{item.itemId}}"
				bindtap="openExchange"
			>
				<view class="{{item.boxCls}}">
					<image class="goods-img" src="{{item.image}}"></image>
				</view>
				<text class="goods-name">{{item.name}}</text>
				<text class="goods-cost">{{item.costText}} 护林币</text>
			</view>
		</view>

		<view class="bottom-pad"></view>
	</scroll-view>

	<app-tabbar active="me" wx:if="{{!guest}}"></app-tabbar>

	<view class="mask" wx:if="{{sheetMode != ''}}">
		<view class="mask-hit" bindtap="closeSheet"></view>
		<view class="sheet">
			<view wx:if="{{sheetMode == 'profile'}}">
				<text class="sheet-title">改个名字</text>
				<text class="sheet-sub">认养树牌、排行榜上都会显示这个名字</text>
				<view class="form-row">
					<text class="form-label">昵称</text>
					<input class="form-input" value="{{nicknameInput}}" bindinput="onNickInput" maxlength="12" placeholder="最多 12 个字" />
				</view>
				<view class="sheet-btn sheet-btn-main" bindtap="saveProfile">
					<text class="sheet-btn-t sheet-btn-t-white">保存</text>
				</view>
			</view>

			<view wx:if="{{sheetMode == 'confirm'}}">
				<text class="sheet-title">{{currentGoods.name}}</text>
				<text class="sheet-sub">{{currentGoods.desc}}</text>
				<view class="hint-box">
					<text class="hint-t">将消耗 {{currentGoods.costText}} 护林币，兑换后生成专属凭证码，到校园绿化服务点出示即可领取。</text>
				</view>
				<view class="sheet-btn sheet-btn-main" bindtap="doExchange">
					<text class="sheet-btn-t sheet-btn-t-white">确认兑换</text>
				</view>
			</view>

			<view wx:if="{{sheetMode == 'ok'}}">
				<view class="ok-head">
					<text class="ok-title">兑换成功</text>
					<text class="ok-sub">{{currentGoods.name}}</text>
				</view>
				<view class="code-box">
					<text class="code-lb">兑换凭证码</text>
					<text class="code-t">{{codeText}}</text>
				</view>
				<view class="sheet-btn sheet-btn-soft" bindtap="closeSheet">
					<text class="sheet-btn-t sheet-btn-t-deep">收好了</text>
				</view>
			</view>
		</view>
	</view>
</view>
