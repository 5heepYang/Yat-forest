.page {
	display: flex;
	flex-direction: column;
	height: 100vh;
	position: relative;
	background-color: #FFFCF6;
	font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "PingFang SC", "MiSans", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
}

.body {
	flex: 1;
	height: 0;
}

.hero {
	display: flex;
	flex-direction: column;
	background-color: #EAF4E6;
	padding-left: 20px;
	padding-right: 20px;
	padding-bottom: 18px;
	border-bottom-left-radius: 24px;
	border-bottom-right-radius: 24px;
}

.status-pad {
	width: 100%;
}

.hero-sub {
	font-size: 10px;
	color: #7E8C82;
	margin-top: 12px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.hero-name {
	font-size: 22px;
	font-weight: bold;
	color: #2E6B4F;
	margin-top: 6px;
	font-family: HYSansBold;
}

.hero-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 14px;
}

.avatar-box {
	display: flex;
	flex-direction: column;
	width: 58px;
	height: 58px;
	border-radius: 29px;
	background-color: #FFF6E4;
	align-items: center;
	justify-content: center;
}

.avatar-img {
	width: 50px;
	height: 50px;
	border-radius: 25px;
}

.hero-info {
	display: flex;
	flex-direction: column;
	flex: 1;
	margin-left: 12px;
}

.hero-line1 {
	font-size: 11px;
	font-weight: bold;
	color: #3D5A48;
	font-family: HYSansBold;
}

.hero-line2 {
	font-size: 10px;
	color: #7E8C82;
	margin-top: 5px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.stats {
	display: flex;
	flex-direction: row;
	padding-top: 18px;
	padding-bottom: 14px;
	margin: 0 20px 0 20px;
}

.stat-cell {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.stat-num {
	font-size: 24px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

/* 护林币数字用主题金 */
.stat-num-gold {
	color: #E0A93F;
}

.stat-num-row {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
}

.stat-unit {
	font-size: 11px;
	font-weight: normal;
	color: #5C6B60;
	margin-left: 2px;
	margin-bottom: 3px;
	font-family: HYSans;
}

.stat-lb {
	font-size: 9px;
	color: #9AA394;
	margin-top: 5px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.sec-row {
	margin: 10px 20px 10px 20px;
}

.sec-title {
	font-size: 12px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

.badge-row {
	display: flex;
	flex-direction: row;
	margin: 0 20px 0 20px;
}

.badge-cell {
	display: flex;
	flex-direction: column;
	width: 25%;
	align-items: center;
}

.badge-circle {
	display: flex;
	flex-direction: column;
	width: 48px;
	height: 48px;
	border-radius: 24px;
	align-items: center;
	justify-content: center;
}

.badge-gold {
	background-color: #FFF6E4;
}

.badge-pink {
	background-color: #FBEDEA;
}

.badge-green {
	background-color: #EAF4E6;
}

.badge-off {
	background-color: #F2F4EF;
}

/* 未点亮勋章：图标去色转深灰（原图是彩色 PNG，靠灰度滤镜压掉） */
.badge-off .badge-ico {
	filter: grayscale(100%);
	opacity: 0.45;
}

.badge-ico {
	width: 24px;
	height: 24px;
}

.badge-name {
	font-size: 9px;
	color: #B4BCAF;
	margin-top: 7px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.badge-name-on {
	color: #5C6B60;
}

.mytree-card {
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: #FFFFFF;
	border-radius: 18px;
	margin: 0 16px 0 16px;
	padding: 12px;
	box-shadow: 0px 4px 14px rgba(46, 107, 79, 0.05);
}

.mt-thumb {
	display: flex;
	flex-direction: column;
	width: 52px;
	height: 52px;
	border-radius: 14px;
	background-color: #F1F8EA;
	align-items: center;
	justify-content: center;
}

.mt-img {
	width: 44px;
	height: 44px;
}

.mt-info {
	display: flex;
	flex-direction: column;
	flex: 1;
	margin-left: 11px;
}

.mt-name {
	font-size: 12px;
	font-weight: bold;
	color: #22302A;
	font-family: HYSansBold;
}

.mt-sub {
	font-size: 9px;
	color: #9AA394;
	margin-top: 4px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.go-pill {
	display: flex;
	flex-direction: row;
	height: 26px;
	border-radius: 13px;
	background-color: #EAF4E6;
	padding-left: 13px;
	padding-right: 13px;
	align-items: center;
	justify-content: center;
}

.go-pill-t {
	font-size: 10px;
	font-weight: bold;
	color: #4E8A6B;
	font-family: HYSansBold;
}

.list-card {
	display: flex;
	flex-direction: column;
	background-color: #F6FAF2;
	border-radius: 18px;
	margin: 10px 16px 0 16px;
	padding-left: 14px;
	padding-right: 14px;
}

.list-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-top: 13px;
	padding-bottom: 13px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #EAF1E4;
}

.list-k {
	font-size: 11px;
	color: #3D5A48;
	font-family: HYSans;
}

.list-v {
	font-size: 10px;
	color: #9AA394;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.goods-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	flex-wrap: wrap;
	margin: 12px 16px 0 16px;
}

.goods-card {
	display: flex;
	flex-direction: column;
	width: 48%;
	box-sizing: border-box;
	background-color: #FFFFFF;
	border-radius: 18px;
	padding: 10px;
	margin-bottom: 12px;
	box-shadow: 0px 4px 14px rgba(46, 107, 79, 0.05);
}

.goods-box {
	display: flex;
	flex-direction: column;
	height: 96px;
	border-radius: 13px;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}

.goods-box-green {
	background-color: #E4F0D9;
}

.goods-box-cream {
	background-color: #FBEFD2;
}

.goods-img {
	width: 100%;
	height: 100%;
	border-radius: 13px;
}

.goods-name {
	font-size: 12px;
	font-weight: bold;
	color: #22302A;
	margin-top: 9px;
	font-family: HYSansBold;
}

.goods-cost {
	font-size: 10px;
	color: #9AA394;
	margin-top: 4px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.bottom-pad {
	height: 20px;
}

/* ------------------------------------------------------------------ */
/* 访客模式（地图页进别人主页）+ 在养的树卡片 + 退出登录                  */
/* ------------------------------------------------------------------ */

.hero-top {
	display: flex;
	flex-direction: row;
	margin-top: 8px;
}

/* 名称行：昵称在左、info 图标在右（自己的主页；访客态只显示昵称） */
.name-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 6px;
}

.name-row .hero-name {
	margin-top: 0;
}

.info-btn {
	display: flex;
	flex-direction: column;
	width: 24px;
	height: 24px;
	border-radius: 12px;
	background-color: #E5EAE2;
	align-items: center;
	justify-content: center;
}

.info-t {
	font-size: 14px;
	font-weight: bold;
	color: #9AA394;
	font-family: HYSansBold;
}

.back-pill {
	display: flex;
	flex-direction: row;
	height: 26px;
	border-radius: 13px;
	background-color: #FFFFFF;
	padding-left: 12px;
	padding-right: 12px;
	align-items: center;
}

.back-t {
	font-size: 11px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

.tree-stack {
	display: flex;
	flex-direction: column;
}

/* 树列表里除最后一张外都留出间距（覆盖 .mytree-card 的 margin） */
.tree-card-row {
	margin: 0 16px 10px 16px;
}

.sec-row-shop {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 22px;
}

/* 资料弹层里的头像选择（微信官方 chooseAvatar 按钮） */
.avatar-btn {
	display: flex;
	flex-direction: column;
	align-items: center;
	background-color: transparent;
	padding: 0;
	margin: 14px 0 0 0;
	border: none;
	line-height: 1.2;
}

.avatar-btn::after {
	border: none;
}

.avatar-sheet-img {
	width: 64px;
	height: 64px;
	border-radius: 32px;
	background-color: #FFF6E4;
}

.avatar-tip {
	font-size: 10px;
	color: #9AA394;
	margin-top: 6px;
	font-family: HYSans;
}

.list-row-last {
	border-bottom-width: 0;
}

/* ------------------------------------------------------------------ */
/* 勋章馆入口 / 签名输入 / 勋章馆与兑换记录弹层 / 商品换行               */
/* ------------------------------------------------------------------ */

.badge-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.more-t {
	font-size: 10px;
	color: #9AA394;
	font-family: HYSans;
}

.form-area {
	height: 72px;
	background-color: #F6FAF2;
	border-radius: 12px;
	padding: 10px 12px 10px 12px;
	margin-top: 7px;
	font-size: 13px;
	color: #22302A;
	font-family: HYSans;
}

.bdg-list {
	display: flex;
	flex-direction: column;
	margin-top: 14px;
}

.bdg-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-top: 10px;
	padding-bottom: 10px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #F0F4EC;
}

.bdg-info {
	display: flex;
	flex-direction: column;
	flex: 1;
	margin-left: 12px;
}

.bdg-name {
	font-size: 12px;
	font-weight: bold;
	color: #B4BCAF;
	font-family: HYSansBold;
}

.bdg-name-on {
	color: #22302A;
}

.bdg-desc {
	font-size: 10px;
	color: #9AA394;
	margin-top: 3px;
	font-family: HYSans;
}

.bdg-state {
	font-size: 10px;
	color: #B4BCAF;
	font-family: HYSans;
}

.bdg-state-on {
	color: #4E8A6B;
	font-weight: bold;
	font-family: HYSansBold;
}

.rec-list {
	display: flex;
	flex-direction: column;
	margin-top: 14px;
}

.rec-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-top: 12px;
	padding-bottom: 12px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #F0F4EC;
}

.rec-name {
	font-size: 12px;
	font-weight: bold;
	color: #22302A;
	font-family: HYSansBold;
}

.rec-code {
	font-size: 11px;
	color: #E0A93F;
	font-family: HYSans;
}

/* 退出登录：红边描线按钮，与上方面板（16px 边距）同宽 */
/* 关于弹层：经济闭环图 */
.flow-box {
	display: flex;
	flex-direction: column;
	background-color: #F0F7EC;
	border-radius: 14px;
	padding: 12px;
	margin-top: 12px;
}

.flow-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-top: 5px;
	padding-bottom: 5px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #E2EDDC;
}

.flow-from {
	font-size: 11px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
	flex-shrink: 0;
}

.flow-arrow {
	font-size: 10px;
	color: #9DC9AA;
	margin-left: 6px;
	margin-right: 6px;
	font-family: HYSans;
	flex-shrink: 0;
}

.flow-to {
	font-size: 11px;
	color: #5C6B60;
	font-family: HYSans;
}

/* 关于弹层的说明分节 */
.about-sec {
	display: flex;
	flex-direction: column;
	background-color: #F6FAF2;
	border-radius: 14px;
	padding: 12px;
	margin-top: 12px;
}

.about-t {
	font-size: 12px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

.about-d {
	font-size: 11px;
	color: #5C6B60;
	line-height: 18px;
	margin-top: 5px;
	font-family: HYSans;
}

.logout-btn {
	display: flex;
	flex-direction: column;
	height: 44px;
	border-radius: 22px;
	border: 1px solid #E07A5F;
	background-color: #FFFFFF;
	margin: 26px 16px 0 16px;
	align-items: center;
	justify-content: center;
}

.logout-btn-t {
	font-size: 13px;
	font-weight: bold;
	color: #B4553F;
	font-family: HYSansBold;
}

.bottom-pad-v {
	height: 44px;
}

.mask {
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(30, 40, 33, 0.32);
	justify-content: flex-end;
	z-index: 100;
}

.mask-hit {
	flex: 1;
}

.sheet {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 26px;
	padding: 20px 18px 24px 18px;
}

.sheet-title {
	font-size: 17px;
	font-weight: bold;
	color: #22302A;
	font-family: HYSansBold;
}

.sheet-sub {
	font-size: 11px;
	color: #9AA394;
	margin-top: 6px;
	font-family: HYSans;
}

.hint-box {
	display: flex;
	flex-direction: column;
	background-color: #F6FAF2;
	border-radius: 14px;
	padding: 12px;
	margin-top: 14px;
}

.hint-t {
	font-size: 12px;
	color: #5C6B60;
	line-height: 19px;
	font-family: HYSans;
}

.sheet-btn {
	display: flex;
	flex-direction: column;
	height: 48px;
	border-radius: 24px;
	align-items: center;
	justify-content: center;
	margin-top: 12px;
}

.sheet-btn-main {
	background-color: #4E8A6B;
}

.sheet-btn-soft {
	background-color: #EAF4E6;
}

.sheet-btn-t {
	font-size: 14px;
	font-weight: bold;
	font-family: HYSansBold;
}

.sheet-btn-t-white {
	color: #FFFFFF;
}

.sheet-btn-t-deep {
	color: #2E6B4F;
}

/* 演示数据重置入口：故意做得不起眼，只有管理员看得到 */
.reset-entry {
	display: flex;
	flex-direction: column;
	margin-top: 18px;
	padding: 12px;
	border-radius: 12px;
	background-color: #FDF3F1;
}

.reset-entry-t {
	font-size: 12px;
	font-weight: bold;
	color: #C0392B;
	font-family: HYSansBold;
}

.reset-entry-d {
	font-size: 10px;
	color: #B4877F;
	margin-top: 4px;
	line-height: 15px;
	font-family: HYSans;
}

.ok-head {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-top: 6px;
}

.ok-title {
	font-size: 16px;
	font-weight: bold;
	color: #2E6B4F;
	font-family: HYSansBold;
}

.ok-sub {
	font-size: 11px;
	color: #9AA394;
	margin-top: 5px;
	font-family: HYSans;
}

.code-box {
	display: flex;
	flex-direction: column;
	background-color: #F6FAF2;
	border-radius: 16px;
	padding: 14px;
	margin-top: 14px;
	align-items: center;
}

.code-lb {
	font-size: 10px;
	color: #9AA394;
	font-family: HYSans;
}

.code-t {
	font-size: 20px;
	font-weight: bold;
	color: #2E6B4F;
	margin-top: 6px;
	font-family: HYSansBold;
}

/* ---------- 我的树（多棵横滑） ---------- */

.sec-row-between {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.sec-more {
	font-size: 10px;
	color: #7A9C86;
	font-family: HYSans;
}

.mytree-bar {
	display: flex;
	flex-direction: row;
	white-space: nowrap;
	margin: 0 16px 0 16px;
}

.mytree-card2 {
	display: inline-flex;
	flex-direction: row;
	align-items: center;
	width: 252px;
	background-color: #FFFFFF;
	border-radius: 18px;
	padding: 10px;
	margin-right: 10px;
	box-shadow: 0px 4px 14px rgba(46, 107, 79, 0.05);
	border: 1px solid transparent;
}

.mytree-card2-on {
	border-color: #BFDCC8;
}

.mytree-empty {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 56px;
	border-radius: 18px;
	background-color: #F6FAF2;
	margin: 0 16px 0 16px;
}

.mytree-empty-t {
	font-size: 11px;
	color: #7A9C86;
	font-family: HYSans;
}

/* ---------- 访客模式返回 ---------- */

.back-pill {
	display: flex;
	flex-direction: row;
	align-self: flex-start;
	height: 26px;
	border-radius: 13px;
	background-color: rgba(255, 255, 255, 0.7);
	align-items: center;
	justify-content: center;
	padding-left: 10px;
	padding-right: 12px;
	margin-bottom: 8px;
}

.back-pill-t {
	font-size: 11px;
	color: #2E6B4F;
	font-family: HYSans;
}
