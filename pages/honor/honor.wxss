/* honor 页 · v3：干净白卡 + 黑字大写标题 + 彩色小标签 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  background-color: #F4F4F4;
  color: #2A3A32;
}

.body {
  flex: 1;
  height: 0;
}

.status-pad {
  width: 100%;
}

/* ---------------- 档案头部 ---------------- */
.hero {
  padding: 6px 16px 0;
}

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.back-pill {
  display: inline-flex;
  align-items: center;
  height: 26px;
  padding: 0 10px;
  border-radius: 999px;
  background-color: #FFFFFF;
}

.back-t {
  font-size: 12px;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

.hero-sub {
  display: block;
  font-size: 11px;
  line-height: 1.4;
  color: #8B908A;
  margin-top: 2px;
}

.name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 2px;
}

.hero-name {
  font-size: 27px;
  line-height: 1.2;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
  letter-spacing: -0.4px;
}

.edit-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 26px;
  padding: 0 11px;
  margin-left: auto;
  border-radius: 999px;
  background-color: #FFFFFF;
}

.edit-t {
  font-size: 11px;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

.hero-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 14px;
}

.avatar-box {
  width: 62px;
  height: 62px;
  border-radius: 50%;
  overflow: hidden;
  background-color: #FFFFFF;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-ph {
  width: 100%;
  height: 100%;
  background-color: #EDEDEA;
  animation: avatarPulse 1.2s ease-in-out infinite;
}

@keyframes avatarPulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

.hero-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-left: 12px;
}

.hero-line1 {
  font-size: 13.5px;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

.hero-line2 {
  font-size: 11.5px;
  color: #8B908A;
  margin-top: 3px;
}

.hero-stamp {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  height: 22px;
  padding: 0 9px;
  border-radius: 999px;
  background-color: #2A3A32;
}

.stamp-t {
  font-size: 10px;
  line-height: 1;
  color: #FFFFFF;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
  letter-spacing: 0.5px;
}

/* ---------------- 四格统计（无竖线、居中） ---------------- */
.stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 18px 16px 0;
  padding: 15px 4px;
  background-color: #FFFFFF;
  border-radius: 16px;
}

.stat-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.stat-num-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
}

.stat-num {
  font-size: 21px;
  line-height: 1.1;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.stat-num-gold {
  color: #E0A526;
}

.stat-unit {
  font-size: 10px;
  color: #8B908A;
  margin-left: 1px;
}

.stat-lb {
  font-size: 10px;
  line-height: 1.3;
  color: #8B908A;
  margin-top: 5px;
}

/* ---------------- 章节 ---------------- */
.sec-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 24px 16px 10px;
}

.sec-title {
  font-size: 15px;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
}

.more-t {
  font-size: 11.5px;
  color: #8B908A;
}

/* ---------------- 勋章 ---------------- */
.badge-head {
  align-items: baseline;
}

.badge-row {
  display: flex;
  flex-direction: row;
  margin: 0 16px;
  padding: 16px 6px;
  background-color: #FFFFFF;
  border-radius: 16px;
}

.badge-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.badge-circle {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background-color: #F4F4F4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-gold {
  background-color: #FFF4DC;
}

.badge-pink {
  background-color: #FDEBE8;
}

.badge-green {
  background-color: #E8F3EA;
}

.badge-off {
  background-color: #F4F4F4;
}

.badge-ico {
  width: 26px;
  height: 26px;
}

.badge-off .badge-ico {
  opacity: 0.22;
  filter: grayscale(1);
}

.badge-name {
  font-size: 10px;
  line-height: 1.3;
  color: #8B908A;
  margin-top: 8px;
  text-align: center;
}

.badge-name-on {
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

.badge-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 16px;
  padding: 28px;
  background-color: #FFFFFF;
  border-radius: 16px;
}

.badge-empty-t {
  font-size: 12px;
  color: #8B908A;
}

/* ---------------- 我的林地 ---------------- */
.tree-stack {
  margin: 0 16px;
}

.mytree-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12px;
  background-color: #FFFFFF;
  border-radius: 16px;
  margin-bottom: 10px;
}

.mt-thumb {
  width: 58px;
  height: 58px;
  border-radius: 14px;
  overflow: hidden;
  background-color: #F4F4F4;
  flex-shrink: 0;
}

.mt-img {
  width: 100%;
  height: 100%;
}

.mt-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-left: 12px;
}

.mt-name {
  font-size: 14.5px;
  line-height: 1.3;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

.mt-sub {
  font-size: 11px;
  line-height: 1.4;
  color: #8B908A;
  margin-top: 3px;
}

.go-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 28px;
  padding: 0 12px;
  border-radius: 999px;
  background-color: #2A3A32;
  flex-shrink: 0;
}

.go-pill-t {
  font-size: 11px;
  color: #FFFFFF;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

/* ---------------- 补给站账簿 ---------------- */
.list-card {
  margin: 0 16px;
  padding: 0 14px;
  background-color: #FFFFFF;
  border-radius: 16px;
}

.list-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 50px;
  border-bottom: 1px solid #F0F0F0;
}

.list-row-last {
  border-bottom: none;
}

.list-k {
  font-size: 13px;
  color: #2A3A32;
}

.list-v {
  font-size: 12.5px;
  color: #8B908A;
}

/* ---------------- 商品卡 ---------------- */
.goods-row {
  display: flex;
  flex-direction: row;
  margin: 10px 16px 0;
}

.goods-card {
  flex: 1;
  padding: 10px;
  background-color: #FFFFFF;
  border-radius: 16px;
  margin-right: 10px;
}

.goods-card:last-child {
  margin-right: 0;
}

.goods-box {
  width: 100%;
  height: 104px;
  border-radius: 12px;
  overflow: hidden;
  background-color: #F4F4F4;
}

.goods-box-green {
  background-color: #E8F3EA;
}

.goods-box-cream {
  background-color: #FFF4DC;
}

.goods-img {
  width: 100%;
  height: 100%;
}

.goods-name {
  display: block;
  font-size: 12.5px;
  line-height: 1.35;
  color: #2A3A32;
  margin-top: 8px;
}

.goods-cost {
  display: block;
  font-size: 13px;
  color: #E0A526;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
  margin-top: 3px;
}

/* ---------------- 退出 ---------------- */
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  margin: 20px 16px 0;
}

.logout-btn-t {
  font-size: 12.5px;
  color: #8B908A;
}

.bottom-pad {
  height: 24px;
}

.bottom-pad-v {
  height: 40px;
}

/* ---------------- 弹层 ---------------- */
.mask-hit {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.sheet-title {
  font-size: 21px;
  line-height: 1.3;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
}

.sheet-sub {
  font-size: 13px;
  line-height: 1.5;
  color: #8B908A;
  margin-top: 6px;
}

.sheet-btn {
  margin-top: 16px;
}

.sheet-btn + .sheet-btn {
  margin-top: 10px;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16px 0 4px;
  background-color: transparent;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-sheet-img {
  width: 76px;
  height: 76px;
  border-radius: 50%;
  background-color: #F4F4F4;
}

.avatar-tip {
  font-size: 11px;
  color: #8B908A;
  margin-top: 8px;
}

.bdg-list {
  margin-top: 14px;
}

.bdg-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 11px 0;
  border-bottom: 1px solid #F0F0F0;
}

.bdg-item .badge-circle {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
}

.bdg-item .badge-ico {
  width: 22px;
  height: 22px;
}

.bdg-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-left: 12px;
}

.bdg-name {
  font-size: 13px;
  color: #8B908A;
}

.bdg-name-on {
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

.bdg-desc {
  font-size: 10.5px;
  line-height: 1.4;
  color: #8B908A;
  margin-top: 2px;
}

.bdg-state {
  font-size: 10.5px;
  color: #C4C4C4;
}

.bdg-state-on {
  color: #38564A;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

.rec-list {
  margin-top: 14px;
}

.rec-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid #F0F0F0;
}

.rec-name {
  font-size: 13px;
  color: #2A3A32;
}

.rec-code {
  font-size: 12px;
  color: #8B908A;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

.ok-head {
  padding: 4px 0 18px;
}

.ok-title {
  display: block;
  font-size: 20px;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
}

.ok-sub {
  display: block;
  font-size: 12px;
  color: #8B908A;
  margin-top: 6px;
}

.code-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18px;
  background-color: #F7F7F7;
  border-radius: 14px;
}

.code-lb {
  font-size: 10.5px;
  color: #8B908A;
}

.code-t {
  font-size: 22px;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
  letter-spacing: 2px;
  margin-top: 8px;
}
/* 昵称条：占满右侧、内容居中 */
.form-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 18px;
}

.form-label {
	flex-shrink: 0;
	margin-right: 12px;
	font-size: 13px;
	color: #8B908A;
	font-weight: 500;
	letter-spacing: 0;
}

.form-input {
	flex: 1;
	height: 50px;
	padding: 0 16px;
	background-color: #F2F2F0;
	border-radius: 12px;
	font-size: 15px;
	color: #2A3A32;
	text-align: center;
}


@media (prefers-reduced-motion: reduce) {
  .avatar-ph {
    animation: none;
  }
}
