<view class="page">
	<view class="status-pad" style="height:{{statusBarHeight}}px"></view>

	<view class="wrap">
		<view class="logo-circle">
			<image class="logo-img" src="/static/illus/palm.png"></image>
		</view>
		<text class="title">中大森友会</text>
		<text class="slogan">认养一棵真树 · 见证它慢慢长大</text>

		<view class="panel">
			<view class="login-btn {{entering ? 'login-btn-mute' : ''}}" bindtap="onWxLogin">
				<text class="login-btn-t">{{entering ? '正在进入…' : '微信一键登录'}}</text>
			</view>
			<text class="tip">登录即开通护林员档案，昵称头像可稍后在「我的」页设置</text>
		</view>
	</view>
</view>
