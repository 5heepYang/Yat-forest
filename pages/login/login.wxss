.page {
	display: flex;
	flex-direction: column;
	min-height: 100vh;
	background-color: #F4F4F4;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.status-pad {
	width: 100%;
}

.wrap {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-left: 30px;
	padding-right: 30px;
	margin-top: 76px;
}

/* 插画不是圆形头像，而是一张压着纸边的标本卡 */
.logo-circle {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 128px;
	height: 128px;
	background-color: #FFFFFF;
	border-radius: 20px;
}

.logo-img {
	width: 96px;
	height: 96px;
}

.title {
	margin-top: 30px;
	font-size: 30px;
	color: #2A3A32;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 800;
	letter-spacing: -0.5px;
}

.slogan {
	margin-top: 10px;
	font-size: 12px;
	color: #8B908A;
	letter-spacing: 0;
}

.panel {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 100%;
	margin-top: 72px;
}

.login-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 50px;
	background-color: #2A3A32;
	border-radius: 14px;
	transition: transform 0.12s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.12s ease;
}

.login-btn-mute {
	background-color: #E9E9E9;
}

.login-btn-t {
	font-size: 14.5px;
	color: #FFFFFF;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	letter-spacing: 0.5px;
}

.login-btn-mute .login-btn-t {
	color: #8B908A;
}

.tip {
	margin-top: 18px;
	padding-left: 2px;
	padding-right: 2px;
	font-size: 11px;
	color: #8B908A;
	line-height: 1.7;
	letter-spacing: 0;
	text-align: center;
}