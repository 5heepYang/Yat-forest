.page {
	display: flex;
	flex-direction: column;
	min-height: 100vh;
	background-color: #FFFCF6;
	font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "PingFang SC", "MiSans", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
}

.status-pad {
	width: 100%;
}

.wrap {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-left: 30px;
	padding-right: 30px;
	margin-top: 100px;
}

.logo-circle {
	display: flex;
	flex-direction: column;
	width: 104px;
	height: 104px;
	border-radius: 52px;
	background-color: #EAF4E6;
	align-items: center;
	justify-content: center;
}

.logo-img {
	width: 72px;
	height: 72px;
}

.title {
	font-size: 24px;
	font-weight: bold;
	color: #2E6B4F;
	margin-top: 22px;
	font-family: HYSansBold;
}

.slogan {
	font-size: 12px;
	color: #9AA394;
	margin-top: 10px;
	letter-spacing: 1px;
	font-family: HYSans;
}

.panel {
	display: flex;
	flex-direction: column;
	width: 100%;
	margin-top: 60px;
	align-items: center;
}

.login-btn {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 50px;
	border-radius: 25px;
	background-color: #4E8A6B;
	align-items: center;
	justify-content: center;
}

.login-btn-mute {
	background-color: #C3CFC2;
}

.login-btn-t {
	font-size: 15px;
	font-weight: bold;
	color: #FFFFFF;
	font-family: HYSansBold;
}

.tip {
	font-size: 10px;
	color: #9AA394;
	margin-top: 14px;
	font-family: HYSans;
}
