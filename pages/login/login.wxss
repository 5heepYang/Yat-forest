.page {
	display: flex;
	flex-direction: column;
	min-height: 100vh;
	background-color: #FAF7F0;
	font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "PingFang SC", "MiSans", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
}

.status-pad {
	width: 100%;
}

.wrap {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-left: 30px;
	padding-right: 30px;
	margin-top: 100px;
}

.logo-circle {
	display: flex;
	flex-direction: column;
	width: 104px;
	height: 104px;
	border-radius: 52px;
	background-color: #E9F2E4;
	align-items: center;
	justify-content: center;
}

.logo-img {
	width: 72px;
	height: 72px;
}

.title {
	font-size: 24px;
	font-weight: bold;
	color: #245A41;
	margin-top: 22px;
	font-family: HYSansBold;
}

.slogan {
	font-size: 12px;
	color: #9AA394;
	margin-top: 10px;
	letter-spacing: 1px;
	font-family: HYSans;
}

.panel {
	display: flex;
	flex-direction: column;
	width: 100%;
	margin-top: 60px;
	align-items: center;
}

.login-btn {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 50px;
	border-radius: 25px;
	background: linear-gradient(135deg, #4A8A66, #3E7D5C);
	align-items: center;
	justify-content: center;
	box-shadow: 0 8px 20px rgba(62, 125, 92, 0.30);
	transition: transform 0.12s ease, opacity 0.12s ease;
}

.login-btn-mute {
	background-color: #C3CFC2;
	background-image: none;
	box-shadow: none;
}

.login-btn-t {
	font-size: 15px;
	font-weight: bold;
	color: #FFFFFF;
	font-family: HYSansBold;
}

.tip {
	font-size: 10px;
	color: #9AA394;
	margin-top: 14px;
	font-family: HYSans;
}
