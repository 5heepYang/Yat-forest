<view class="page">
	<nav-bar title="低碳日程" subtitle="{{dateLine}}">
		<view class="icon-btn" bindtap="openAdd">
			<image class="icon-18" src="/static/ui/calendar.png"></image>
		</view>
	</nav-bar>

	<scroll-view class="body" scroll-y>
		<view class="energy-card">
			<text class="e-label">今日碳能量</text>
			<view class="e-row">
				<view class="e-left">
					<text class="e-num">{{todayPoints}}</text>
					<text class="e-unit">分</text>
				</view>
				<view class="e-right">
					<text class="e-acc">{{totalCarbonG}} g</text>
					<text class="e-acc-lb">累计少排 CO₂e</text>
				</view>
			</view>
			<view class="e-bar">
				<view class="e-bar-in" style="{{barStyle}}"></view>
			</view>
			<text class="e-hint">今日目标 {{carbonGoal}} 分 · 已完成 {{progressPct}}%</text>
		</view>

		<view class="task-card" wx:if="{{groups.length > 0}}">
			<block wx:for="{{groups}}" wx:key="label" wx:for-item="group">
				<text class="group-label">{{group.label}}</text>
				<view
					class="task-row"
					wx:for="{{group.tasks}}"
					wx:key="taskId"
					data-id="{{item.taskId}}"
					bindtap="openTask"
				>
					<text class="task-time">{{item.slot}}</text>
					<view class="task-main">
						<text class="{{item.done ? 'task-title task-title-done' : 'task-title'}}">{{item.title}}</text>
						<text class="task-desc">{{item.desc}}</text>
					</view>
					<text class="{{item.done ? 'task-pt task-pt-done' : 'task-pt'}}">{{item.done || item.basePoints > 0 ? '+' + item.basePoints : '…'}}</text>
				</view>
			</block>
		</view>

		<view class="task-card" wx:else>
			<text class="empty-t">今天还没有日程，点右上角添加一条</text>
		</view>

		<view class="week-head">
			<text class="sec-title">本周碳账本</text>
			<text class="week-streak">{{streakText}}</text>
		</view>

		<view class="bars">
			<view class="bar-col" wx:for="{{weekBars}}" wx:key="idx">
				<view class="{{item.cls}}" style="height:{{item.h}}"></view>
			</view>
		</view>

		<view class="ai-btn" bindtap="askAi">
			<text class="ai-t">✦  问 AI 管家：今天还能再省多少？</text>
		</view>

		<view class="bottom-pad"></view>
	</scroll-view>

	<app-tabbar active="task"></app-tabbar>

	<view class="mask" wx:if="{{sheetMode != ''}}">
		<view class="mask-hit" bindtap="closeSheet"></view>
		<view class="sheet">
			<view wx:if="{{sheetMode == 'add'}}">
				<text class="sheet-title">添加今日日程</text>
				<text class="sheet-sub">写下要做的事，AI 帮你规划低碳做法</text>
				<view class="sheet-field">
					<text class="field-lb">要做的事</text>
					<input class="field-input" value="{{addTitle}}" maxlength="30" placeholder="如：去教学楼上课" bindinput="onAddTitle"></input>
				</view>
				<view class="sheet-field">
					<text class="field-lb">时间</text>
					<picker class="field-picker" mode="time" value="{{addSlot}}" bindchange="onAddSlot">
						<view class="picker-val">{{addSlot}}</view>
					</picker>
				</view>
				<view class="sheet-btn sheet-btn-main" bindtap="confirmAdd">
					<text class="sheet-btn-t sheet-btn-t-white">创建，等 AI 分析</text>
				</view>
			</view>

			<view wx:if="{{sheetMode == 'task'}}">
				<text class="sheet-title">{{current.title}}</text>
				<text class="sheet-sub">{{current.slot}} · {{current.desc}}</text>
				<view class="hint-box">
					<text class="hint-t">上传凭证照片（乘车码截图 / 空盘 / 骑行记录），AI 会自动核验真实性与减碳量。</text>
				</view>
				<image wx:if="{{proofThumb != ''}}" class="proof-thumb" src="{{proofThumb}}" mode="aspectFill"></image>
				<view class="proof-row">
					<view class="sheet-btn sheet-btn-soft proof-btn" bindtap="pickPhoto" data-src="camera">
						<text class="sheet-btn-t sheet-btn-t-deep">拍照</text>
					</view>
					<view class="sheet-btn sheet-btn-soft proof-btn" bindtap="pickPhoto" data-src="album">
						<text class="sheet-btn-t sheet-btn-t-deep">相册选图</text>
					</view>
				</view>
				<view class="sheet-field">
					<text class="field-lb">文字凭证</text>
					<input class="field-input" value="{{proofText}}" maxlength="50" placeholder="如：今天骑行 3.2 公里" bindinput="onProofText" bindblur="onProofBlur"></input>
				</view>
				<view class="sheet-btn sheet-btn-main" bindtap="startVerify">
					<text class="sheet-btn-t sheet-btn-t-white">提交核验</text>
				</view>
			</view>

			<view wx:if="{{sheetMode == 'loading'}}" class="loading-box">
				<text class="loading-t">AI 多模态核验中{{dots}}</text>
				<text class="loading-s">正在识别凭证场景并核算碳排放</text>
			</view>

			<view wx:if="{{sheetMode == 'result'}}">
				<view class="result-head">
					<view class="result-badge">
						<text class="result-badge-t">核验通过</text>
					</view>
					<text class="result-carbon">{{result.carbonSavedG}} g</text>
					<text class="result-carbon-lb">本次减少碳排放</text>
				</view>
				<view class="hint-box">
					<text class="hint-t">{{result.comment}}</text>
				</view>
				<text class="result-detail">{{result.detail}}</text>
				<view class="sheet-btn sheet-btn-main" bindtap="claim">
					<text class="sheet-btn-t sheet-btn-t-white">领取 {{currentPoints}} 积分</text>
				</view>
			</view>

			<view wx:if="{{sheetMode == 'reject'}}">
				<view class="reject-head">
					<view class="reject-badge">
						<text class="reject-badge-t">凭证未通过</text>
					</view>
				</view>
				<view class="hint-box">
					<text class="hint-t">{{result.comment}}</text>
				</view>
				<text class="result-detail">{{result.detail}}</text>
				<view class="sheet-btn sheet-btn-main" bindtap="retryProof">
					<text class="sheet-btn-t sheet-btn-t-white">换一张凭证重试</text>
				</view>
			</view>

			<view wx:if="{{sheetMode == 'advice'}}">
				<text class="sheet-title">AI 日程碳管家</text>
				<text class="sheet-sub">基于你今天的日程与任务完成情况</text>
				<view class="hint-box">
					<text class="hint-t">{{advice}}</text>
				</view>
				<view class="sheet-btn sheet-btn-soft" bindtap="closeSheet">
					<text class="sheet-btn-t sheet-btn-t-deep">知道了</text>
				</view>
			</view>
		</view>
	</view>
</view>
