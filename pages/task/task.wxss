.page {
	display: flex;
	flex-direction: column;
	height: 100vh;
	position: relative;
	background-color: #FAF7F0;
	font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "PingFang SC", "MiSans", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
}

.body {
	flex: 1;
	height: 0;
}

/* 今日碳积分：v1 的页面主视觉锚点 —— 深绿渐变 + 金色进度，纯样式改动 */
.energy-card {
	display: flex;
	flex-direction: column;
	background: radial-gradient(120px 80px at 90% 0%, rgba(255, 255, 255, 0.14), transparent 60%), linear-gradient(135deg, #245A41, #3E7D5C 55%, #4E9A70);
	border-radius: 22px;
	padding: 18px 16px 16px;
	margin: 6px 16px 0 16px;
	box-shadow: 0 10px 24px rgba(36, 90, 65, 0.28);
	animation: riseIn 260ms cubic-bezier(0.22, 0.9, 0.35, 1) 1 backwards;
}

.e-label {
	font-size: 10.5px;
	color: rgba(255, 255, 255, 0.72);
	letter-spacing: 1px;
	font-family: HYSans;
}

.e-row {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-between;
	margin-top: 2px;
}

.e-left {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
}

.e-num {
	font-size: 44px;
	font-weight: bold;
	color: #FFFFFF;
	font-family: HYSansBold;
}

.e-unit {
	font-size: 11px;
	color: rgba(255, 255, 255, 0.70);
	margin-left: 5px;
	margin-bottom: 9px;
	font-family: HYSans;
}

.e-right {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	padding-bottom: 6px;
}

.e-acc {
	font-size: 15px;
	font-weight: bold;
	color: #F2C879;
	font-family: HYSansBold;
}

.e-acc-lb {
	font-size: 10px;
	color: rgba(255, 255, 255, 0.60);
	margin-top: 3px;
	font-family: HYSans;
}

.e-bar {
	height: 8px;
	background-color: rgba(255, 255, 255, 0.22);
	border-radius: 4px;
	margin-top: 14px;
	overflow: hidden;
}

.e-bar-in {
	height: 8px;
	background: linear-gradient(90deg, #F2C879, #EFC063);
	border-radius: 4px;
	animation: barGrow 600ms cubic-bezier(0.22, 0.9, 0.35, 1) 1 both;
}

.e-hint {
	font-size: 10px;
	color: rgba(255, 255, 255, 0.66);
	margin-top: 8px;
	letter-spacing: 0.6px;
	font-family: HYSans;
}

.sec-label {
	font-size: 11px;
	color: #9AA394;
	margin: 18px 22px 8px 22px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.task-card {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 22px;
	margin: 0 16px 0 16px;
	padding: 4px 16px 4px 16px;
	box-shadow: 0 1px 2px rgba(31, 43, 36, 0.04), 0 8px 24px rgba(36, 90, 65, 0.08);
	animation: riseIn 260ms cubic-bezier(0.22, 0.9, 0.35, 1) 70ms 1 backwards;
}

/* 时段分组小标签（卡片内） */
.group-label {
	display: flex;
	font-size: 11px;
	color: #9AA394;
	padding-top: 12px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

/* 日程表标题行：左侧「今日日程」，右侧「新建日程」 */
.task-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin: 18px 22px 6px 22px;
}

.task-add {
	font-size: 12px;
	color: #3E7D5C;
	font-family: HYSansBold;
	padding: 2px 0 2px 12px;
}

/* 空日程：整张卡片可点，点击直接新建 */
.task-empty {
	border: 1px dashed #CFE3D4;
}

/* 空日程提示 */
.empty-t {
	display: flex;
	font-size: 13px;
	color: #3E7D5C;
	padding: 22px 0;
	justify-content: center;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.task-row {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	padding-top: 13px;
	padding-bottom: 13px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #F2F5EE;
}

.task-time {
	width: 44px;
	font-size: 10px;
	color: #B4BCAF;
	padding-top: 3px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.task-main {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.task-title {
	font-size: 13px;
	font-weight: bold;
	color: #1F2B24;
	font-family: HYSansBold;
}

.task-title-done {
	color: #8D9A8F;
}

.task-desc {
	font-size: 10px;
	color: #A6B0A2;
	margin-top: 4px;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.task-pt {
	width: 64px;
	font-size: 13px;
	font-weight: bold;
	color: #B4BCAF;
	text-align: right;
	padding-top: 2px;
	font-family: HYSansBold;
}

/* 核验通过后积分变绿 */
.task-pt-done {
	color: #3E7D5C;
}

.week-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin: 18px 22px 6px 22px;
}

.sec-title {
	font-size: 14px;
	font-weight: bold;
	color: #245A41;
	font-family: HYSansBold;
}

.week-streak {
	font-size: 10px;
	color: #9AA394;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

/* 本周一次减碳任务都没完成时的空态 */
.week-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	margin: 12px 16px 0 16px;
	padding: 20px 0;
	background-color: #FFFFFF;
	border-radius: 18px;
	box-shadow: 0 1px 2px rgba(31, 43, 36, 0.04), 0 8px 24px rgba(36, 90, 65, 0.08);
}

.week-empty-t {
	font-size: 12px;
	color: #9AA394;
	letter-spacing: 0.4px;
	font-family: HYSans;
}

.bars {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-between;
	margin: 0 20px 0 20px;
	height: 70px;
}

.bar-col {
	display: flex;
	flex-direction: column;
	flex: 1;
	align-items: center;
	justify-content: flex-end;
}

.wbar {
	width: 24px;
	border-radius: 8px;
	background-color: #E2E8D8;
}

.wbar-mid {
	background-color: #9CC7AB;
}

.wbar-on {
	background: linear-gradient(180deg, #4E9A70, #3E7D5C);
	box-shadow: 0 3px 8px rgba(62, 125, 92, 0.30);
}

.ai-btn {
	display: flex;
	flex-direction: column;
	height: 52px;
	border-radius: 26px;
	background-color: #FFFFFF;
	border: 1.5px dashed #BFD6C3;
	align-items: center;
	justify-content: center;
	margin: 20px 16px 0 16px;
	transition: transform 0.12s ease, opacity 0.12s ease;
}

.ai-t {
	font-size: 13px;
	font-weight: bold;
	color: #245A41;
	font-family: HYSansBold;
}

.bottom-pad {
	height: 20px;
}

.mask {
	display: flex;
	flex-direction: column;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(26, 36, 30, 0.40);
	justify-content: flex-end;
	z-index: 100;
}

.mask-hit {
	flex: 1;
}

.sheet {
	display: flex;
	flex-direction: column;
	background-color: #FFFFFF;
	border-radius: 26px;
	padding: 20px 18px calc(24px + env(safe-area-inset-bottom)) 18px;
}

.sheet-title {
	font-size: 17px;
	font-weight: bold;
	color: #1F2B24;
	font-family: HYSansBold;
}

.sheet-sub {
	font-size: 11px;
	color: #9AA394;
	margin-top: 6px;
	font-family: HYSans;
}

.hint-box {
	display: flex;
	flex-direction: column;
	background-color: #F2F7EC;
	border-radius: 14px;
	padding: 12px;
	margin-top: 14px;
}

.hint-t {
	font-size: 12px;
	color: #5C6B60;
	line-height: 19px;
	font-family: HYSans;
}

.sheet-btn {
	display: flex;
	flex-direction: column;
	height: 46px;
	border-radius: 23px;
	align-items: center;
	justify-content: center;
	margin-top: 12px;
	transition: transform 0.12s ease, opacity 0.12s ease;
}

.sheet-btn-main {
	background: linear-gradient(135deg, #4A8A66, #3E7D5C);
	box-shadow: 0 8px 18px rgba(62, 125, 92, 0.28);
}

.sheet-btn-soft {
	background-color: #E9F2E4;
}

.sheet-btn-t {
	font-size: 14px;
	font-weight: bold;
	font-family: HYSansBold;
}

.sheet-btn-t-white {
	color: #FFFFFF;
}

.sheet-btn-t-deep {
	color: #245A41;
}

.loading-box {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 30px 0 24px 0;
}

.loading-t {
	font-size: 15px;
	font-weight: bold;
	color: #245A41;
	font-family: HYSansBold;
}

.loading-s {
	font-size: 11px;
	color: #9AA394;
	margin-top: 8px;
	font-family: HYSans;
}

.result-head {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-top: 8px;
}

.result-badge {
	display: flex;
	flex-direction: row;
	height: 26px;
	border-radius: 13px;
	background-color: #E9F2E4;
	padding-left: 12px;
	padding-right: 12px;
	align-items: center;
	justify-content: center;
}

.result-badge-t {
	font-size: 11px;
	font-weight: bold;
	color: #3E7D5C;
	font-family: HYSansBold;
}

.result-carbon {
	font-size: 34px;
	font-weight: bold;
	color: #245A41;
	margin-top: 12px;
	font-family: HYSansBold;
}

.result-carbon-lb {
	font-size: 10px;
	color: #9AA394;
	margin-top: 2px;
	font-family: HYSans;
}

.result-detail {
	font-size: 10px;
	color: #B4BCAF;
	margin-top: 10px;
	line-height: 16px;
	font-family: HYSans;
}

/* 核验对象：让用户看清楚 AI 核的是"做法"而不是"去干嘛" */
.verify-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 10px;
	padding: 8px 12px;
	border-radius: 12px;
	background-color: #F3F9EF;
}

.verify-lb {
	font-size: 10px;
	color: #9AA394;
	font-family: HYSans;
	margin-right: 8px;
}

.verify-val {
	font-size: 13px;
	font-weight: bold;
	color: #245A41;
	font-family: HYSansBold;
}

.loading-slow {
	font-size: 11px;
	color: #C08A3E;
	margin-top: 8px;
	font-family: HYSans;
}

.verify-evidence {
	font-size: 10px;
	color: #3E7D5C;
	margin-top: 6px;
	line-height: 15px;
	font-family: HYSans;
}

/* 添加日程表单 */
.sheet-field {
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: #F2F7EC;
	border-radius: 14px;
	padding: 12px;
	margin-top: 12px;
}

.field-lb {
	width: 64px;
	font-size: 12px;
	color: #5C6B60;
	font-family: HYSans;
}

.field-input {
	flex: 1;
	height: 34px;
	font-size: 13px;
	color: #1F2B24;
	font-family: HYSans;
}

.field-picker {
	flex: 1;
}

.picker-val {
	font-size: 15px;
	font-weight: bold;
	color: #245A41;
	font-family: HYSansBold;
}

/* 凭证缩略图与拍照/相册按钮行 */
.proof-thumb {
	width: 100%;
	height: 150px;
	border-radius: 14px;
	margin-top: 14px;
}

.proof-row {
	display: flex;
	flex-direction: row;
	margin-top: 12px;
}

.proof-btn {
	flex: 1;
	margin-top: 0;
}

.proof-btn:first-child {
	margin-right: 10px;
}

/* ---------- 核验驳回 ---------- */

.reject-head {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-top: 8px;
}

.reject-badge {
	display: flex;
	flex-direction: row;
	height: 26px;
	border-radius: 13px;
	background-color: #FBEDE8;
	padding-left: 12px;
	padding-right: 12px;
	align-items: center;
	justify-content: center;
}

.reject-badge-t {
	font-size: 11px;
	font-weight: bold;
	color: #C0392B;
	font-family: HYSansBold;
}
