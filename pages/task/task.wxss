/* ==========================================================================
   低碳日程 · 牌局语言
   记分牌（墨色）→ 任务牌（纸牌 + 点数）→ 本周账本（刻度柱）→ 抽建议牌
   ========================================================================== */

.page {
	display: flex;
	flex-direction: column;
	height: 100vh;
	box-sizing: border-box;
	position: relative;
	background-color: #F4F4F4;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.body {
	flex: 1;
	height: 0;
}

/* ------------------------------------------------------------------ */
/* 1. 记分牌：墨底、纸白字、朱砂刻度                                    */
/* ------------------------------------------------------------------ */

.energy-card {
	position: relative;
	margin: 8px 16px 0;
	padding: 18px;
	background-color: #2A3A32;
	border-radius: 16px;
	box-shadow: 0 8px 20px -12px rgba(42, 58, 50, 0.45);
	animation: dealIn 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.e-label {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 11px;
	letter-spacing: 0;
	color: rgba(255, 255, 255, 0.55);
}

.e-row {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-between;
	margin-top: 6px;
}

.e-left {
	display: flex;
	flex-direction: row;
	align-items: baseline;
}

.e-num {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 800;
	font-size: 44px;
	line-height: 1;
	letter-spacing: -1px;
	color: #FFFFFF;
	font-variant-numeric: tabular-nums;
}

.e-unit {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 13px;
	color: rgba(255, 255, 255, 0.6);
	margin-left: 6px;
	letter-spacing: 0;
}

.e-right {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	padding-bottom: 4px;
}

.e-acc {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 16px;
	color: #FFFFFF;
	letter-spacing: 0;
	font-variant-numeric: tabular-nums;
}

.e-acc-lb {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 10px;
	letter-spacing: 0;
	color: rgba(255, 255, 255, 0.5);
	margin-top: 4px;
}

/* 进度条：白色细条压在淡底上 */
.e-bar {
	position: relative;
	height: 6px;
	margin-top: 18px;
	background-color: rgba(255, 255, 255, 0.18);
	border-radius: 999px;
	overflow: hidden;
}

.e-bar-in {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	min-width: 6px;
	background-color: #FFFFFF;
	border-radius: 999px;
}

.e-hint {
	display: block;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 11px;
	letter-spacing: 0;
	color: rgba(255, 255, 255, 0.45);
	margin-top: 10px;
}

/* ------------------------------------------------------------------ */
/* 2. 日程：一组牌                                                     */
/* ------------------------------------------------------------------ */

.task-head {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	justify-content: space-between;
	margin: 24px 16px 0;
	animation: dealIn 340ms cubic-bezier(0.22, 1, 0.36, 1) 60ms both;
}

.sec-title {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 800;
	font-size: 15px;
	letter-spacing: -0.1px;
	color: #2A3A32;
}

.task-add {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 11.5px;
	letter-spacing: 0;
	color: #2A3A32;
	padding-bottom: 1px;
}

.task-card {
	display: flex;
	flex-direction: column;
	margin: 12px 16px 0;
	padding: 0 14px;
	background-color: #FFFFFF;
	border-radius: 16px;
}

.group-label {
	display: block;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 11px;
	letter-spacing: 0;
	color: #8B908A;
	margin-top: 14px;
	margin-bottom: 0;
}

/* 任务行：白卡内的列表行，极淡分隔 */
.task-row {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	padding: 13px 0;
	border-bottom: 1px solid #F2F2F2;
	animation: dealIn 340ms cubic-bezier(0.22, 1, 0.36, 1) 100ms both;
}

.task-row:last-child {
	border-bottom: none;
}

.task-done {
	opacity: 0.55;
}

.task-done::after {
	content: "已完成";
	position: absolute;
	right: 0;
	bottom: 12px;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 9px;
	letter-spacing: 0.2px;
	color: #FFFFFF;
	background-color: #2A3A32;
	border-radius: 999px;
	padding: 2px 7px;
}

.task-time {
	width: 46px;
	flex-shrink: 0;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 12.5px;
	letter-spacing: 0;
	color: #8B908A;
	padding-top: 3px;
	font-variant-numeric: tabular-nums;
}

.task-main {
	display: flex;
	flex-direction: column;
	flex: 1;
	padding-left: 2px;
	padding-right: 8px;
}

.task-title {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 14.5px;
	line-height: 1.4;
	letter-spacing: 0.1px;
	color: #2A3A32;
}

.task-title-done {
	color: #B0B0B0;
	text-decoration: line-through;
}

.task-desc {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 11px;
	line-height: 1.5;
	color: #8B908A;
	margin-top: 3px;
	letter-spacing: 0;
}

/* 点数：右侧 +50 */
.task-pt {
	width: 48px;
	flex-shrink: 0;
	text-align: right;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 800;
	font-size: 17px;
	line-height: 1.3;
	letter-spacing: -0.2px;
	color: #38564A;
	font-variant-numeric: tabular-nums;
}

.task-pt-done {
	color: #E0A526;
}

.task-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	margin: 12px 16px 0;
	padding: 26px 0;
	background-color: #FFFFFF;
	border-radius: 16px;
}

.empty-t {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 12px;
	letter-spacing: 0.2px;
	color: #8B908A;
}

/* ------------------------------------------------------------------ */
/* 3. 本周碳账本：刻度柱                                               */
/* ------------------------------------------------------------------ */

.week-head {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	justify-content: space-between;
	margin: 30px 18px 0;
	animation: dealIn 340ms cubic-bezier(0.22, 1, 0.36, 1) 160ms both;
}

.week-streak {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 10px;
	letter-spacing: 0.3px;
	color: #8B908A;
}

.week-empty {
	display: flex;
	flex-direction: column;
	margin: 12px 16px 0;
	padding: 24px 0;
	background-color: #FFFFFF;
	border-radius: 16px;
}

.week-empty-t {
	display: block;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 11px;
	letter-spacing: 0.3px;
	color: #8B908A;
	text-align: center;
}

.bars {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-between;
	height: 76px;
	margin: 12px 16px 0;
	padding: 14px 14px 0;
	background-color: #FFFFFF;
	border-radius: 16px;
}

.bar-col {
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	width: 22px;
	height: 100%;
}

.wbar {
	width: 22px;
	min-height: 3px;
	background-color: #E8E8E8;
	border-radius: 4px 4px 0 0;
}

.wbar-mid {
	background-color: #BDBDBD;
}

.wbar-on {
	background-color: #2A3A32;
}

/* ------------------------------------------------------------------ */
/* 4. 抽建议牌：虚线牌 + 朱砂角章                                      */
/* ------------------------------------------------------------------ */

.ai-btn {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin: 20px 16px 0;
	padding: 16px;
	border: none;
	border-radius: 16px;
	background-color: #FFFFFF;
}

.ai-t {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 13.5px;
	letter-spacing: 0;
	color: #2A3A32;
}

.bottom-pad {
	height: 12px;
}

/* ------------------------------------------------------------------ */
/* 5. 弹层：从牌堆里抽出的一张纸                                       */
/* ------------------------------------------------------------------ */

.mask {
	position: fixed;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(42, 58, 50, 0.45);
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	z-index: 100;
}

.mask-hit {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.sheet {
	position: relative;
	background-color: #FFFFFF;
	border-radius: 24px 24px 0 0;
	padding: 20px 20px calc(22px + env(safe-area-inset-bottom));
	max-height: 82vh;
	overflow-y: auto;
}

.sheet-title {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 800;
	font-size: 21px;
	letter-spacing: -0.2px;
	color: #2A3A32;
	line-height: 1.3;
}

.sheet-sub {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 13px;
	letter-spacing: 0;
	color: #8B908A;
	margin-top: 6px;
	line-height: 1.6;
}

.sheet-field {
	display: flex;
	flex-direction: column;
	margin-top: 16px;
	padding: 12px 14px;
	border-bottom: none;
	background-color: #F7F7F7;
	border-radius: 12px;
}

.field-lb {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 12.5px;
	letter-spacing: 0;
	color: #8B908A;
}

.field-input {
	width: 100%;
	height: 30px;
	margin-top: 3px;
	padding: 0;
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 15px;
	color: #2A3A32;
	background-color: transparent;
}

.field-picker {
	margin-top: 2px;
}

.picker-val {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 16px;
	line-height: 38px;
	letter-spacing: 0.3px;
	color: #2A3A32;
}

.proof-thumb {
	width: 132px;
	height: 132px;
	margin-top: 14px;
	border: 1px solid rgba(34, 36, 31, 0.2);
	border-radius: 12px;
}

.proof-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	margin-top: 14px;
}

.proof-btn {
	flex: 1;
	margin-left: 8px;
	margin-top: 0;
}

.proof-btn:first-child {
	margin-left: 0;
}

/* 核验中：不卖萌，只说明在做什么 */
.loading-box {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	padding: 22px 0 26px;
}

.loading-t {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 14px;
	letter-spacing: 0.3px;
	color: #2A3A32;
}

.loading-slow {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 12px;
	letter-spacing: 0.6px;
	color: #8B908A;
	margin-top: 8px;
}

/* 通过：朱砂章 + 大数字 */
.result-head {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	padding: 6px 0 2px;
}

.result-badge {
	display: flex;
	flex-direction: row;
	padding: 4px 8px;
	border: 1px solid #E4E2D9;
	margin-bottom: 14px;
}

.result-badge-t {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 11px;
	letter-spacing: 0.3px;
	color: #2A3A32;
}

.result-carbon {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 44px;
	line-height: 1;
	letter-spacing: 0.3px;
	color: #2A3A32;
	font-variant-numeric: tabular-nums;
}

.result-carbon-lb {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-size: 10px;
	letter-spacing: 0.3px;
	color: #8B908A;
	margin-top: 8px;
}

.reject-head {
	display: flex;
	flex-direction: row;
	padding: 6px 0 2px;
}

.reject-badge {
	display: flex;
	flex-direction: row;
	padding: 4px 8px;
	border: 1px solid #F0F0F0;
	border-left: 4px solid #2A3A32;
}

.reject-badge-t {
	font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
	font-weight: 700;
	font-size: 11px;
	letter-spacing: 0.3px;
	color: #2A3A32;
}