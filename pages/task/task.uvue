<template>
	<view class="page">
		<nav-bar title="低碳日程" :subtitle="dateLine">
			<view class="icon-btn" @click="onCalendar">
				<image class="icon-18" src="/static/ui/calendar.png"></image>
			</view>
		</nav-bar>

		<scroll-view class="body" direction="vertical">
			<view class="energy-card">
				<text class="e-label">今日碳能量</text>
				<view class="e-row">
					<view class="e-left">
						<text class="e-num">{{ todayPoints().toFixed(0) }}</text>
						<text class="e-unit">分</text>
					</view>
					<view class="e-right">
						<text class="e-acc">{{ fmt(store.user.totalGrowthScore) }} g</text>
						<text class="e-acc-lb">累计少排 CO₂e</text>
					</view>
				</view>
				<view class="e-bar">
					<view class="e-bar-in" :style="barStyle"></view>
				</view>
				<text class="e-hint">今日目标 {{ store.carbonGoal.toFixed(0) }} 分 · 已完成 {{ progressPct().toFixed(0) }}%</text>
			</view>

			<text class="sec-label">{{ sectionLabel }}</text>

			<view class="task-card">
				<view v-for="t in store.tasks" :key="t.taskId" class="task-row" @click="openTask(t)">
					<text class="task-time">{{ t.slot }}</text>
					<view class="task-main">
						<text :class="t.done ? 'task-title task-title-done' : 'task-title'">{{ t.title }}</text>
						<text class="task-desc">{{ t.desc }}</text>
					</view>
					<text :class="t.done ? 'task-pt task-pt-done' : 'task-pt'">+{{ t.basePoints.toFixed(0) }}</text>
				</view>
			</view>

			<view class="week-head">
				<text class="sec-title">本周碳账本</text>
				<text class="week-streak">连续 5 天</text>
			</view>

			<view class="bars">
				<view v-for="(v, i) in store.weekBars" :key="i" class="bar-col">
					<view :class="barClass(i)" :style="barHeight(v)"></view>
				</view>
			</view>

			<view class="ai-btn" @click="askAi">
				<text class="ai-t">✦  问 AI 管家：今天还能再省多少？</text>
			</view>

			<view class="bottom-pad"></view>
		</scroll-view>

		<app-tabbar active="task"></app-tabbar>

		<view class="mask" v-if="sheetMode != ''">
			<view class="mask-hit" @click="closeSheet"></view>
			<view class="sheet">
				<view v-if="sheetMode == 'task'">
					<text class="sheet-title">{{ current.title }}</text>
					<text class="sheet-sub">{{ current.slot }} · {{ current.desc }}</text>
					<view class="hint-box">
						<text class="hint-t">上传凭证照片（乘车码截图 / 空盘 / 骑行记录），AI 会自动核验真实性与减碳量。</text>
					</view>
					<view class="sheet-btn sheet-btn-main" @click="useSample">
						<text class="sheet-btn-t sheet-btn-t-white">使用示例凭证（模拟核验）</text>
					</view>
					<view class="sheet-btn sheet-btn-soft" @click="pickPhoto">
						<text class="sheet-btn-t sheet-btn-t-deep">从相册选一张照片</text>
					</view>
				</view>

				<view v-if="sheetMode == 'loading'" class="loading-box">
					<text class="loading-t">AI 多模态核验中{{ dots }}</text>
					<text class="loading-s">正在识别凭证场景并核算碳排放</text>
				</view>

				<view v-if="sheetMode == 'result'">
					<view class="result-head">
						<view class="result-badge">
							<text class="result-badge-t">核验通过</text>
						</view>
						<text class="result-carbon">{{ result.carbonSavedG.toFixed(0) }} g</text>
						<text class="result-carbon-lb">本次减少碳排放</text>
					</view>
					<view class="hint-box">
						<text class="hint-t">{{ result.comment }}</text>
					</view>
					<text class="result-detail">{{ result.detail }}</text>
					<view class="sheet-btn sheet-btn-main" @click="claim">
						<text class="sheet-btn-t sheet-btn-t-white">领取 {{ current.basePoints.toFixed(0) }} 积分</text>
					</view>
				</view>

				<view v-if="sheetMode == 'advice'">
					<text class="sheet-title">AI 日程碳管家</text>
					<text class="sheet-sub">基于你今天的日程与任务完成情况</text>
					<view class="hint-box">
						<text class="hint-t">{{ advice }}</text>
					</view>
					<view class="sheet-btn sheet-btn-soft" @click="closeSheet">
						<text class="sheet-btn-t sheet-btn-t-deep">知道了</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup>
	import NavBar from '@/components/nav-bar.uvue'
	import AppTabbar from '@/components/app-tabbar.uvue'
	import { CarbonTask, AiProofResult } from '@/common/model.uts'
	import { store, todayPoints, doneCount, progressPct, completeTask } from '@/common/store.uts'
	import { aiVerifyProof, aiAdvice } from '@/common/ai.uts'
	import { fmt, todayText, toast } from '@/common/util.uts'

	function emptyTask() : CarbonTask {
		const t : CarbonTask = {
			taskId: '', slot: '', title: '', desc: '', basePoints: 0,
			done: false, carbonSavedG: 0, aiComment: ''
		}
		return t
	}

	const dateLine = todayText()
	const sheetMode = ref<string>('')
	const current = ref<CarbonTask>(emptyTask())
	const advice = ref<string>('')
	const dots = ref<string>('')
	let dotTimer : number = 0

	const result = ref<AiProofResult>({
		passed: false, carbonSavedG: 0, comment: '', detail: ''
	} as AiProofResult)

	const sectionLabel = computed(() : string => {
		if (store.tasks.length == 0) {
			return '今日日程'
		}
		return '上午 · ' + store.tasks[0].slot + ' - 10:00'
	})

	const barStyle = computed(() : string => {
		return 'width:' + progressPct().toFixed(0) + '%'
	})

	function weekMax() : number {
		let m = 1
		let i = 0
		while (i < store.weekBars.length) {
			if (store.weekBars[i] > m) {
				m = store.weekBars[i]
			}
			i++
		}
		return m
	}

	function barHeight(v : number) : string {
		const h = v / weekMax() * 66
		return 'height:' + h.toFixed(0) + 'px'
	}

	function barClass(i : number) : string {
		if (i == 6) {
			return 'wbar wbar-on'
		}
		if (i == 5 || i == 3) {
			return 'wbar wbar-mid'
		}
		return 'wbar'
	}

	function startDots() {
		dots.value = ''
		dotTimer = setInterval(() => {
			dots.value = dots.value.length >= 3 ? '' : dots.value + '.'
		}, 300)
	}

	function stopDots() {
		if (dotTimer != 0) {
			clearInterval(dotTimer)
			dotTimer = 0
		}
	}

	function closeSheet() {
		stopDots()
		sheetMode.value = ''
	}

	function openTask(t : CarbonTask) {
		if (t.done) {
			toast('这个任务已核验通过，减少排放 ' + t.carbonSavedG.toFixed(0) + ' g')
			return
		}
		current.value = t
		sheetMode.value = 'task'
	}

	function startVerify() {
		sheetMode.value = 'loading'
		startDots()
		aiVerifyProof(current.value.title, current.value.basePoints, (r : AiProofResult) => {
			stopDots()
			result.value = r
			sheetMode.value = 'result'
		})
	}

	function useSample() {
		startVerify()
	}

	function pickPhoto() {
		uni.chooseImage({
			count: 1,
			success: (res) => {
				console.log('凭证图片：', res.tempFilePaths)
				startVerify()
			}
		})
	}

	function claim() {
		const err = completeTask(current.value.taskId, result.value.carbonSavedG, result.value.comment)
		if (err != '') {
			toast(err)
		} else {
			toast('+' + current.value.basePoints.toFixed(0) + ' 积分已到账')
		}
		sheetMode.value = ''
	}

	function askAi() {
		sheetMode.value = 'advice'
		advice.value = 'AI 正在翻你的日程表…'
		aiAdvice(doneCount(), store.tasks.length, (text : string) => {
			advice.value = text
		})
	}

	function onCalendar() {
		toast('1.0 骨架：日程协同入口，队员 B 可在此接入课表导入')
	}
</script>

