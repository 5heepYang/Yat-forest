/* 全局样式 */

page {
  background-color: #FFFCF6;
  -webkit-font-smoothing: antialiased;
}

/* uvue 里 view 默认是纵向 flex；小程序 view 默认 block。
   凡是需要参与弹性布局的容器，都要显式写 display:flex 并补 flex-direction:column，
   否则会退化成 CSS 默认的 row 方向，布局会全乱。 */
.fx {
  display: flex;
  flex-direction: column;
}

.fx-row {
  display: flex;
  flex-direction: row;
}

/* ------------------------------------------------------------------ */
/* 护林币胶囊（林地页赚币现场 / 个人页补给站共用）                      */
/* ------------------------------------------------------------------ */

.coin-pill {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 26px;
	border-radius: 13px;
	background-color: #FFF6E4;
	padding-left: 9px;
	padding-right: 12px;
}

.coin-ico {
	width: 16px;
	height: 16px;
	margin-right: 4px;
}

.coin-t {
	font-size: 11px;
	font-weight: bold;
	color: #E0A93F;
	font-family: HYSansBold;
}

/* ------------------------------------------------------------------ */
/* 底部弹层通用件（配合 components/sheet 使用，页面里直接写 class 即可） */
/* ------------------------------------------------------------------ */

.hint-box {
  display: flex;
  flex-direction: column;
  background-color: #F6FAF2;
  border-radius: 14px;
  padding: 12px;
  margin-top: 14px;
}

.hint-t {
  font-size: 12px;
  color: #5C6B60;
  line-height: 19px;
  font-family: HYSans;
}

.sheet-btn {
  display: flex;
  flex-direction: column;
  height: 48px;
  border-radius: 24px;
  align-items: center;
  justify-content: center;
  margin-top: 12px;
}

.sheet-btn-main {
  background-color: #4E8A6B;
}

.sheet-btn-soft {
  background-color: #EAF4E6;
}

.sheet-btn-mute {
  background-color: #C3CFC2;
}

.sheet-btn-t {
  font-size: 14px;
  font-weight: bold;
  font-family: HYSansBold;
}

.sheet-btn-t-white {
  color: #FFFFFF;
}

.sheet-btn-t-deep {
  color: #2E6B4F;
}

/* 底部弹层标题/副标题强制纵向排布（text 默认 inline，会把两行拼到一起） */
.sheet-title,
.sheet-sub {
	display: block;
}

/* 表单行：新增树木 / 新增日程这类弹窗里用 */
.form-row {
  display: flex;
  flex-direction: column;
  margin-top: 14px;
}

.form-label {
  font-size: 11px;
  color: #9AA394;
  font-family: HYSans;
  letter-spacing: 0.4px;
}

.form-input {
  height: 44px;
  background-color: #F6FAF2;
  border-radius: 12px;
  padding-left: 12px;
  padding-right: 12px;
  margin-top: 7px;
  font-size: 13px;
  color: #22302A;
  font-family: HYSans;
}

/* ------------------------------------------------------------------ */
/* tab 页切页入场动画                                                   */
/* 两套等价 keyframes 交替：只有 computed animation 变化才会重放动画；    */
/* 页面常驻，tabBar 点目标页时先挂 .page-anim-paused（暂停在 0% 帧），    */
/* 切回首帧即动画起点，onShow 移除暂停后才播放，避免一帧跳变。            */
/* 位移作用在 .page 上，fill-mode 用 none：结束后不残留 transform，       */
/* 避免内部 fixed 元素以 .page 为包含块。                                */
/* ------------------------------------------------------------------ */

@keyframes pageInRight1 {
  0% {
    opacity: 0;
    transform: translateX(36px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pageInRight2 {
  0% {
    opacity: 0;
    transform: translateX(36px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pageInLeft1 {
  0% {
    opacity: 0;
    transform: translateX(-36px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pageInLeft2 {
  0% {
    opacity: 0;
    transform: translateX(-36px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pageInFade1 {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

@keyframes pageInFade2 {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

.page-anim-right-1 {
  animation: pageInRight1 220ms ease-out none;
}

.page-anim-right-2 {
  animation: pageInRight2 220ms ease-out none;
}

.page-anim-left-1 {
  animation: pageInLeft1 220ms ease-out none;
}

.page-anim-left-2 {
  animation: pageInLeft2 220ms ease-out none;
}

.page-anim-fade-1 {
  animation: pageInFade1 180ms ease-out none;
}

.page-anim-fade-2 {
  animation: pageInFade2 180ms ease-out none;
}

/* 预置态：tabBar 点击时先挂上，动画停在 0% 帧；目标页 onShow 移除本类才播放 */
.page-anim-paused {
  animation-play-state: paused !important;
}

/* 自定义 tabBar 占位：tabBar 固定悬浮，页面内留出等量高度，避免底部内容被遮 */
.tabbar-holder {
  height: calc(78px + env(safe-area-inset-bottom));
}
