/* ============================================================
   app.wxss · 全局视觉系统 v3
   方向参考：干净白卡 + 强对比黑字 + 彩色小标签 + 手绘插画
   字重：HYSans(400) 正文 / HYSansBold(700) 强调 / HYSansHeavy(900) 标题
   ============================================================ */

page {
  background-color: #F4F4F4;
  color: #2A3A32;
  font-size: 13.5px;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, image, input, textarea, button, scroll-view {
  box-sizing: border-box;
}

/* ---------------- 文字 ---------------- */
.display {
  font-size: 30px;
  line-height: 1.15;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
  letter-spacing: -0.3px;
}

.title {
  font-size: 22px;
  line-height: 1.25;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
  letter-spacing: -0.2px;
}

.num {
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.kicker {
  font-size: 10.5px;
  line-height: 1.4;
  color: #8B908A;
  letter-spacing: 0.2px;
}

.sec-title {
  font-size: 16px;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 800;
  letter-spacing: -0.1px;
}

.note {
  font-size: 11.5px;
  line-height: 1.55;
  color: #8B908A;
}

.rule {
  height: 1px;
  background-color: #ECECEC;
}

.clip {
  overflow: hidden;
}

/* ---------------- 布局 ---------------- */
.fx {
  display: flex;
}

.fx-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* ---------------- 卡片 ---------------- */
.card {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 16px;
}

.card-ink {
  background-color: #2A3A32;
  border-radius: 16px;
  padding: 16px;
  color: #FFFFFF;
}

/* 旧装饰角线在 v3 中不再使用 */
.corner,
.corner-tl,
.corner-br,
.corner-s,
.corner-n,
.corner-n-light {
  display: none;
}

/* ---------------- 标签 / 印章 ---------------- */
.stamp {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 20px;
  padding: 0 7px;
  border-radius: 999px;
  background-color: #2A3A32;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 19px;
  padding: 0 7px;
  border-radius: 999px;
  background-color: #3B7DD8;
}

.tag-red {
  background-color: #38564A;
}

.tag-gold {
  background-color: #E0A526;
}

/* ---------------- 按钮 ---------------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  border-radius: 12px;
  background-color: #2A3A32;
}

.btn-ink {
  background-color: #2A3A32;
}

.btn-primary {
  background-color: #38564A;
}

.btn-red {
  background-color: #38564A;
}

.btn-t {
  font-size: 15px;
  color: #FFFFFF;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.btn-t-light {
  color: #FFFFFF;
}

/* 弹层按钮（沿用旧类名，统一到 v3 视觉） */
.sheet-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  border-radius: 12px;
  background-color: #2A3A32;
}

.sheet-btn-main {
  background-color: #2A3A32;
}

.sheet-btn-soft {
  background-color: #F1F1F1;
}

.sheet-btn-mute {
  background-color: #2A3A32;
  opacity: 0.26;
}

.sheet-btn-t {
  font-size: 15px;
  color: #FFFFFF;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.sheet-btn-t-white {
  color: #FFFFFF;
}

.sheet-btn-t-deep {
  color: #2A3A32;
}

/* ---------------- 积分胶囊 ---------------- */
.coin-pill {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  height: 24px;
  padding: 0 9px;
  border-radius: 999px;
  background-color: #FFFFFF;
}

.coin-ico {
  width: 13px;
  height: 13px;
  margin-right: 4px;
}

.coin-t {
  font-size: 11.5px;
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}

/* ---------------- 提示块 ---------------- */
.hint-box {
  background-color: #F7F7F7;
  border-radius: 12px;
  padding: 12px 14px;
}

.hint-t {
  font-size: 11.5px;
  line-height: 1.7;
  color: #6B6B6B;
}

/* ---------------- 弹层标题 ---------------- */
.sheet-title,
.sheet-sub {
  display: block;
}

/* ---------------- 表单 ---------------- */
.form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 54px;
}

.form-label {
  font-size: 12px;
  color: #8B908A;
}

.form-input {
  height: 48px;
  font-size: 15px;
  color: #2A3A32;
  background-color: #F7F7F7;
  border-radius: 12px;
  padding: 0 12px;
}

/* ---------------- 页面切换 ---------------- */
@keyframes pageInRight1 {
  from {
    opacity: 0;
    transform: translateX(24px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pageInRight2 {
  from {
    opacity: 0;
    transform: translateX(18px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pageInLeft1 {
  from {
    opacity: 0;
    transform: translateX(-24px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pageInLeft2 {
  from {
    opacity: 0;
    transform: translateX(-18px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pageInFade1 {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes pageInFade2 {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.page-anim-right-1 {
  animation: pageInRight1 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.page-anim-right-2 {
  animation: pageInRight2 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.page-anim-left-1 {
  animation: pageInLeft1 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.page-anim-left-2 {
  animation: pageInLeft2 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.page-anim-fade-1 {
  animation: pageInFade1 0.24s ease both;
}

.page-anim-fade-2 {
  animation: pageInFade2 0.26s ease both;
}

.page-anim-paused {
  animation-play-state: paused;
}

/* 按压反馈 */
.hv-press {
  opacity: 0.7;
}

/* ---------------- 入场动效 ---------------- */
@keyframes dealIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim-deal {
  animation: dealIn 0.34s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.anim-deal-d1 {
  animation-delay: 0.05s;
}

.anim-deal-d2 {
  animation-delay: 0.1s;
}

.anim-deal-d3 {
  animation-delay: 0.15s;
}

.anim-deal-d4 {
  animation-delay: 0.2s;
}

.anim-deal-d5 {
  animation-delay: 0.25s;
}

@keyframes flipIn {
  from {
    opacity: 0;
    transform: perspective(600px) rotateX(-14deg);
  }
  to {
    opacity: 1;
    transform: perspective(600px) rotateX(0);
  }
}

.anim-flip {
  animation: flipIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  transform-origin: center top;
}

@keyframes stampDown {
  from {
    opacity: 0;
    transform: scale(1.3);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.anim-stamp {
  animation: stampDown 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes growIn {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

.anim-grow {
  transform-origin: left center;
  animation: growIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim-rise {
  animation: riseIn 0.3s ease both;
}

.anim-rise-d1 {
  animation-delay: 0.06s;
}

.anim-rise-d2 {
  animation-delay: 0.12s;
}

.anim-rise-d3 {
  animation-delay: 0.18s;
}

@keyframes breathRing {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(216, 66, 58, 0);
  }
  50% {
    box-shadow: 0 0 0 5px rgba(216, 66, 58, 0.1);
  }
}

.anim-breath {
  animation: breathRing 2.4s ease-in-out infinite;
}

@keyframes floatIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim-float {
  animation: floatIn 0.5s ease both;
}

/* ---------------- 遮罩与弹层 ---------------- */
@keyframes maskIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background-color: rgba(42, 58, 50, 0.45);
  animation: maskIn 0.2s ease both;
}

@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  max-height: 84vh;
  overflow-y: auto;
  padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-radius: 24px 24px 0 0;
  animation: sheetUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.sheet::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 8px;
  margin-left: -18px;
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background-color: #E6E6E6;
}

/* ---------------- 底部占位 ---------------- */
.tabbar-holder {
  height: calc(70px + env(safe-area-inset-bottom));
}

@media (prefers-reduced-motion: reduce) {
  .anim-deal,
  .anim-deal-d1,
  .anim-deal-d2,
  .anim-deal-d3,
  .anim-deal-d4,
  .anim-deal-d5,
  .anim-flip,
  .anim-stamp,
  .anim-grow,
  .anim-rise,
  .anim-rise-d1,
  .anim-rise-d2,
  .anim-rise-d3,
  .anim-breath,
  .anim-float,
  .page-anim-right-1,
  .page-anim-right-2,
  .page-anim-left-1,
  .page-anim-left-2,
  .page-anim-fade-1,
  .page-anim-fade-2,
  .mask,
  .sheet {
    animation: none;
  }
}