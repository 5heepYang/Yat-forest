/* 自定义 tabBar：固定悬浮在页面底部，页面里用 .tabbar-holder 占位避免内容被遮 */
.tabbar-fixed {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	/* 必须低于所有弹层（详情卡 z:15、上传弹窗 z:25、各页 mask z:100），否则弹窗底部会被 tabBar 压住 */
	z-index: 5;
	display: flex;
	flex-direction: column;
	background-color: transparent;
	padding-left: 12px;
	padding-right: 12px;
	padding-top: 6px;
	padding-bottom: calc(10px + env(safe-area-inset-bottom));
}

.tabbar {
	display: flex;
	flex-direction: row;
	font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "PingFang SC", "MiSans", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
	height: 62px;
	background-color: #FFFFFF;
	border-radius: 31px;
	align-items: center;
	box-shadow: 0px 6px 24px rgba(46, 107, 79, 0.12);
}

.tb-cell {
	display: flex;
	flex-direction: column;
	flex: 1;
	align-items: center;
	justify-content: center;
}

.tb-pill {
	display: flex;
	flex-direction: column;
	height: 50px;
	padding-left: 13px;
	padding-right: 13px;
	border-radius: 25px;
	align-items: center;
	justify-content: center;
}

.tb-pill-on {
	background-color: #EAF4E6;
}

.tb-ico {
	width: 20px;
	height: 20px;
}

.tb-t {
	font-size: 9px;
	color: #9AA394;
	margin-top: 4px;
	font-family: HYSans;
}

.tb-t-on {
	color: #2E6B4F;
	font-weight: bold;
}