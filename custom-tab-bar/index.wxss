/* custom-tab-bar · v3：白底贴边，选中项为黑色圆形 + 白色图标 */
.tabbar-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  background-color: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar {
  display: flex;
  flex-direction: row;
  height: 58px;
  border-top: 1px solid #F0F0F0;
}

.tb-cell {
  display: flex;
  flex: 1;
}

.tb-pill {
  position: relative;
  flex: 1;
}

.tb-ico {
  position: absolute;
  left: 50%;
  top: 9px;
  margin-left: -10px;
  width: 20px;
  height: 20px;
  opacity: 0.42;
}

.tb-t {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6px;
  font-size: 10px;
  line-height: 1.2;
  text-align: center;
  color: #B0B0B0;
}

.tb-pill-on::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 2px;
  margin-left: -18px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: #2A3A32;
}

.tb-pill-on .tb-ico {
  top: 10px;
  margin-left: -9px;
  width: 18px;
  height: 18px;
  opacity: 1;
  filter: brightness(0) invert(1);
}

.tb-t-on {
  color: #2A3A32;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-weight: 700;
}